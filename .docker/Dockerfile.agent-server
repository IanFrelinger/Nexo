# Nexo API + .NET SDK in the final image so background tester/optimizer agents can run `dotnet test` / builds against a mounted workspace.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore application/src/Nexo.API/Nexo.API.csproj
# Nexo.API multi-targets net8.0;net10.0 (net8.0 only for in-repo library consumers); the image ships net10.0.
RUN dotnet publish application/src/Nexo.API/Nexo.API.csproj -c Release -f net10.0 -o /app/publish --no-restore

# Nexo.API ships net10.0, and the SDK 10 image carries the 10.0 ASP.NET Core shared runtime,
# so no extra runtime install is needed (the old image had to add the 8.0 runtime on SDK 9).
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /app

COPY --from=build /app/publish ./

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "Nexo.API.dll"]
