# Ashlar API + .NET SDK in the final image so background tester/optimizer agents can run `dotnet test` / builds against a mounted workspace.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore application/src/Ashlar.API/Ashlar.API.csproj
# Ashlar.API multi-targets net8.0;net10.0 (net8.0 only for in-repo library consumers); the image ships net10.0.
RUN dotnet publish application/src/Ashlar.API/Ashlar.API.csproj -c Release -f net10.0 -o /app/publish --no-restore

# Ashlar.API ships net10.0, and the SDK 10 image carries the 10.0 ASP.NET Core shared runtime,
# so no extra runtime install is needed (the old image had to add the 8.0 runtime on SDK 9).
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /app

COPY --from=build /app/publish ./

# Runtime state (LiteDB stores, snapshots) goes to /data/state, not into the mounted workspace under
# /work (docs/DEPLOYMENT.md, "Runtime state"). This image intentionally stays root: the tester/optimizer
# agents run dotnet build/test against a host bind mount whose ownership the image cannot know.
ENV ASPNETCORE_URLS=http://+:8080 \
    ASHLAR_STATE_DIR=/data/state \
    ASHLAR_DAILIES_PATH=/data/dailies
RUN mkdir -p /data/state /data/dailies
EXPOSE 8080

# SDK image: curl is present here (unlike the aspnet runtime images).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["dotnet", "Ashlar.API.dll"]
