# Nexo API + .NET SDK in the final image so background tester/optimizer agents can run `dotnet test` / builds against a mounted workspace.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore application/src/Nexo.API/Nexo.API.csproj
RUN dotnet publish application/src/Nexo.API/Nexo.API.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/sdk:9.0
WORKDIR /app

# Nexo.API targets net8.0; SDK 9 images ship the 9.0 shared runtime only — install 8.0 ASP.NET Core runtime for the published app.
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && chmod +x /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh --channel 8.0 --runtime aspnetcore --install-dir /usr/share/dotnet \
    && rm /tmp/dotnet-install.sh

COPY --from=build /app/publish ./

# Runtime state (LiteDB stores, snapshots) goes to /data/state, not into the mounted workspace under
# /work (docs/DEPLOYMENT.md, "Runtime state"). This image intentionally stays root: the tester/optimizer
# agents run dotnet build/test against a host bind mount whose ownership the image cannot know.
ENV ASPNETCORE_URLS=http://+:8080 \
    NEXO_STATE_DIR=/data/state \
    NEXO_DAILIES_PATH=/data/dailies
RUN mkdir -p /data/state /data/dailies
EXPOSE 8080

# SDK image: curl is present here (unlike the aspnet runtime images).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["dotnet", "Nexo.API.dll"]
