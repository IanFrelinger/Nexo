# Dockerfile for Ashlar CLI - multi-stage build
# Flexible defaults for deployability across environments.
ARG DOTNET_SDK_VERSION=10.0
ARG DOTNET_RUNTIME_VERSION=10.0
ARG TARGETFRAMEWORK=net10.0
ARG TARGETARCH=amd64
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:${DOTNET_SDK_VERSION} AS build
ARG TARGETFRAMEWORK
WORKDIR /src

COPY . .

# Skip CopyAssemblies (test infra script; not needed for CLI publish)
ENV SkipCopyAssemblies=true

# Restore and publish CLI - framework dependent by default.
# Use single-node MSBuild in container builds to avoid intermittent file-lock races.
# The framework is selected with -f on the ENTRY project only, and the TARGETFRAMEWORK
# variable is captured then UNSET before dotnet runs: MSBuild lifts environment
# variables into global properties, and a global TargetFramework poisons single-TF
# projects in the graph (the netstandard2.0-only analyzers referencing multi-TF
# contracts fail with net8-vs-ns2.0 mismatches). Per-reference framework negotiation
# is the supported idiom; nothing in the environment may override it.
RUN TFM="${TARGETFRAMEWORK:-net10.0}" && unset TARGETFRAMEWORK && \
    dotnet restore application/src/Ashlar.CLI/Ashlar.CLI.csproj -m:1 && \
    dotnet publish application/src/Ashlar.CLI/Ashlar.CLI.csproj -c Release -o /app/publish \
        -m:1 --self-contained false -f "$TFM" -p:BuildInParallel=false -p:UseAppHost=false -p:SkipCopyAssemblies=true \
        -p:ErrorOnDuplicatePublishOutputFiles=false

# Runtime stage
# CLI transitively depends on ASP.NET Core shared framework via hosting references.
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_RUNTIME_VERSION}
WORKDIR /app

COPY --from=build /app/publish/ /app/

# Runtime state (LiteDB stores, snapshots) goes to /data/state instead of <mounted repo>/.ashlar/state so a
# read-only or foreign-owned workspace mount never blocks the CLI; mount a volume there to keep it.
#
# ASHLAR_KEY_DIR and ASHLAR_MESH_DIR are the node's IDENTITY and its published packages. Without
# them OperatorKey.ResolveKeyDir() falls back to ~/.ashlar/keys and MeshStore.Resolve to
# ~/.ashlar/mesh/published — both inside the container HOME — so `docker rm` destroys the operator
# key and every package the node ever published. Measured: the replacement container does not
# report a DIFFERENT key, it reports NO key, and then records gate decisions UNSIGNED. A node that
# silently stops signing is worse than one that visibly changes name.
#
# NOTE: MeshStore.Resolve APPENDS '/published' to ASHLAR_MESH_DIR (MeshStore.cs:31). The directory
# to hand a sync tool is therefore $ASHLAR_MESH_DIR/published — one level off here yields an empty
# peer store with no error, which reads identically to a peer that is simply switched off.
#
# The gate store is deliberately absent from this block: no environment variable reaches it. It
# lives at <projectDir>/.ashlar/gates and is persisted only by working_dir — see deploy/node.yml.
ENV ASHLAR_STATE_DIR=/data/state \
    ASHLAR_FORGE_ROOT=/data/state/runtime-studio/forge \
    ASHLAR_OBJECTIVES_ROOT=/data/state/runtime-studio/objectives \
    ASHLAR_OBSERVATIONS_PATH=/data/state/runtime-studio/observations \
    ASHLAR_KEY_DIR=/data/state/keys \
    ASHLAR_MESH_DIR=/data/state/mesh \
    ASHLAR_CYCLE_EVENTS_PATH=/data/state/runtime-studio/cycles.jsonl
RUN mkdir -p /data/state/runtime-studio /app/.ashlar /app/config && chown -R app:app /data /app/.ashlar /app/config

# A default agent set, so a node does WORK instead of idling. Without a config the daemon binds
# BackgroundAgents:Agents to an empty list and creates zero agents — the node stays up, logs
# nothing interesting, and any soak charts a flat line by construction.
#
# The shipped agent is an EXTENDER, but the node still ships SAFE: aggressiveness mode defaults to
# Passive (FileBasedAggressivenessModeStore), and in Passive the extender branch logs
# "observe only" and returns WITHOUT running a self-extend cycle. It does still increment the
# cycle count, which is the difference between "the agent set loaded" and "the node rewrites
# itself" — the first is Phase 1's exit criterion, the second is a deliberate operator act
# (`ashlar background-agent mode`, persisted via ASHLAR_AGENT_MODE_PATH).
#
# Parameters.RepoRoot is REQUIRED, not decoration: BackgroundAgentRegistry only takes the extender
# branch when TryGetParameter finds RepoRoot or Path, so omitting it silently downgrades the agent
# to a no-op with no error anywhere.
COPY .docker/node-agents.json /app/config/agents.json

# Non-root: the aspnet 8+ images ship an unprivileged 'app' user (numeric $APP_UID so k8s runAsNonRoot can
# verify it). Commands that write into a mounted workspace need it writable by that uid (or run with --user).
USER $APP_UID

WORKDIR /app
ENTRYPOINT ["dotnet", "/app/Ashlar.CLI.dll"]
CMD ["--help"]
