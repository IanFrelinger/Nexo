# Dockerfile for Nexo CLI - multi-stage build
# Flexible defaults for deployability across environments.
ARG DOTNET_SDK_VERSION=9.0
ARG DOTNET_RUNTIME_VERSION=8.0
ARG TARGETFRAMEWORK=net8.0
ARG TARGETARCH=amd64
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:${DOTNET_SDK_VERSION} AS build
ARG TARGETFRAMEWORK
WORKDIR /src

COPY . .

# Skip CopyAssemblies (test infra script; not needed for CLI publish)
ENV SkipCopyAssemblies=true
ENV TARGETFRAMEWORK=${TARGETFRAMEWORK:-net8.0}

# Restore and publish CLI - framework dependent by default.
# Use single-node MSBuild in container builds to avoid intermittent file-lock races.
RUN dotnet restore application/src/Nexo.CLI/Nexo.CLI.csproj -p:TargetFramework="${TARGETFRAMEWORK}" -m:1 && \
    dotnet publish application/src/Nexo.CLI/Nexo.CLI.csproj -c Release -o /app/publish \
        -m:1 --self-contained false -p:TargetFramework="${TARGETFRAMEWORK}" -p:BuildInParallel=false -p:UseAppHost=false -p:SkipCopyAssemblies=true \
        -p:ErrorOnDuplicatePublishOutputFiles=false

# Runtime stage
# CLI transitively depends on ASP.NET Core shared framework via hosting references.
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_RUNTIME_VERSION}
WORKDIR /app

COPY --from=build /app/publish/ /app/

WORKDIR /app
ENTRYPOINT ["dotnet", "/app/Nexo.CLI.dll"]
CMD ["--help"]
