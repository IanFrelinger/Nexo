# Smol audio pipeline: yt-dlp + Whisper tiny (39M params)
# Extracts audio from YouTube and transcribes to stdout.
#
# Build: docker build -f .docker/Dockerfile.youtube-transcribe -t nexo-youtube-transcribe .
# Run:   docker run --rm -e VIDEO_URL="https://youtube.com/watch?v=..." nexo-youtube-transcribe
#
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir openai-whisper yt-dlp

WORKDIR /workspace

# Entrypoint: download audio, transcribe with tiny model, output transcript
ENV WHISPER_MODEL=tiny
COPY .docker/scripts/youtube-transcribe-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
