# Dockerfile for headless YouTube video summary tests via Universal Tester
# Uses Xvfb (virtual X display) + Chrome/Chromium + DesktopAdapter (scrot screenshots)
# Fully virtualized - no physical display required. Parallel-safe in separate containers.
# Portable: amd64 (PC) and arm64 (MacBook Apple Silicon).
#
# Build (multi-arch): docker buildx build -f .docker/Dockerfile.youtube-test -t nexo-youtube-test --platform linux/amd64,linux/arm64 .
# Build (host arch):  docker build -f .docker/Dockerfile.youtube-test -t nexo-youtube-test .
# Run:   docker run --rm -e VIDEO_URL="https://..." -e OLLAMA_BASE_URL="http://host.docker.internal:11434" nexo-youtube-test
#
ARG DOTNET_VERSION=8.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}

# TARGETARCH is set by Docker buildx when using --platform (e.g. amd64, arm64)
ARG TARGETARCH=amd64

# Install Xvfb, scrot, ffmpeg, xdotool (for virtual desktop interaction), browser.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    scrot \
    ffmpeg \
    xdotool \
    curl \
    wget \
    gnupg \
    ca-certificates \
    && if [ "$TARGETARCH" = "amd64" ]; then \
        wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-linux-signing-key.gpg \
        && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-linux-signing-key.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
        && apt-get update && apt-get install -y --no-install-recommends google-chrome-stable; \
    else \
        apt-get install -y --no-install-recommends chromium; \
    fi \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy solution and projects (override global.json to match SDK 8.0 runtime)
COPY *.sln Directory.*.props ./
COPY src/ ./src/
COPY scripts/ ./scripts/
RUN echo '{"sdk":{"version":"8.0.0","rollForward":"latestMinor","allowPrerelease":false}}' > global.json

# Restore and build Nexo CLI (skip CopyAssemblies in Docker to avoid targeting pack issues)
RUN dotnet restore src/Nexo.CLI/Nexo.CLI.csproj -p:TargetFramework=net8.0 \
    && dotnet build src/Nexo.CLI/Nexo.CLI.csproj --configuration Release --no-restore -f net8.0 -p:TreatWarningsAsErrors=false -p:SkipCopyAssemblies=true -p:TargetFrameworks=net8.0 \
    && dotnet publish src/Nexo.CLI/Nexo.CLI.csproj --configuration Release --no-build -o /app/nexo

ENV DISPLAY=:99
# C# entrypoint: nexo demo youtube-container (replaces shell script)
ENTRYPOINT ["dotnet", "/app/nexo/Nexo.CLI.dll", "demo", "youtube-container"]
