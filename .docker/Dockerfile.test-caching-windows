# Dockerfile for running multi-platform tests on Windows
# Note: Requires Windows containers (not Linux containers)
ARG DOTNET_VERSION=10.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-nanoserver-ltsc2022

# Set working directory
WORKDIR C:\workspace

# Copy project files
COPY . .

# Restore dependencies for test projects
RUN dotnet restore src\Ashlar.Tests.Infrastructure\Ashlar.Tests.Infrastructure.csproj && dotnet restore src\Ashlar.Tests.BackgroundAgents\Ashlar.Tests.BackgroundAgents.csproj

# Build test projects
RUN dotnet build src\Ashlar.Tests.Infrastructure\Ashlar.Tests.Infrastructure.csproj --no-restore && dotnet build src\Ashlar.Tests.BackgroundAgents\Ashlar.Tests.BackgroundAgents.csproj --no-restore

# Default command: run base framework smoke tests
CMD ["cmd", "/c", "dotnet test src\\Ashlar.Tests.Infrastructure\\Ashlar.Tests.Infrastructure.csproj --filter \"(FullyQualifiedName~BaseFrameworkSmokeTests|FullyQualifiedName~RuntimeStudioBlackBoxSmokeTests)\" --logger \"console;verbosity=normal\" && dotnet test src\\Ashlar.Tests.BackgroundAgents\\Ashlar.Tests.BackgroundAgents.csproj --filter \"FullyQualifiedName~RuntimeStudioWhiteBoxSmokeTests\" --logger \"console;verbosity=normal\""]
