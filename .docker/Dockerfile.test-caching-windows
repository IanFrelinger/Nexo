# Dockerfile for running multi-platform tests on Windows
# Note: Requires Windows containers (not Linux containers)
ARG DOTNET_VERSION=8.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-nanoserver-ltsc2022

# Set working directory
WORKDIR C:\workspace

# Copy project files
COPY . .

# Restore dependencies for test projects
RUN dotnet restore src\Nexo.Tests.Infrastructure\Nexo.Tests.Infrastructure.csproj

# Build test projects
RUN dotnet build src\Nexo.Tests.Infrastructure\Nexo.Tests.Infrastructure.csproj --no-restore

# Default command: run base framework smoke tests
CMD ["cmd", "/c", "dotnet test src\\Nexo.Tests.Infrastructure\\Nexo.Tests.Infrastructure.csproj --filter \"FullyQualifiedName~BaseFrameworkSmokeTests\" --logger \"console;verbosity=normal\""]
