# Dockerfile for running multi-platform tests on Alpine Linux
ARG DOTNET_VERSION=9.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-alpine

# Install dependencies
RUN apk add --no-cache \
        curl \
        git \
        python3 \
        py3-pip \
        bash \
        protobuf \
        grpc-plugins

# Set working directory
WORKDIR /workspace

# Skip CopyAssemblies tool in container
ENV DOTNET_RUNNING_IN_CONTAINER=true
# Use Alpine-native protobuf/grpc plugins to avoid glibc binary incompatibility in Grpc.Tools.
ENV PROTOBUF_PROTOC=/usr/bin/protoc
ENV GRPC_PROTOC_PLUGIN=/usr/bin/grpc_csharp_plugin

# Copy project files
COPY . .

# Install .NET 8.0 runtime for CLI (targets net8.0)
RUN wget -qO /tmp/dotnet-install.sh https://dot.net/v1/dotnet-install.sh && \
    bash /tmp/dotnet-install.sh --channel 8.0 --runtime aspnetcore --install-dir /usr/share/dotnet --no-path && \
    bash /tmp/dotnet-install.sh --channel 8.0 --runtime dotnet --install-dir /usr/share/dotnet --no-path && \
    rm /tmp/dotnet-install.sh

# Restore dependencies for test projects and CLI
RUN dotnet restore src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj && \
    dotnet restore src/Nexo.Tests.Infrastructure/scripts/copy-assemblies.csproj && \
    dotnet restore src/Nexo.Tests.BackgroundAgents/Nexo.Tests.BackgroundAgents.csproj && \
    dotnet restore src/Nexo.CLI/Nexo.CLI.csproj

# Build test projects for net9.0 and CLI for net8.0
RUN dotnet build src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj -f net9.0 --no-restore -p:TreatWarningsAsErrors=false && \
    dotnet build src/Nexo.Tests.BackgroundAgents/Nexo.Tests.BackgroundAgents.csproj -f net9.0 --no-restore -p:TreatWarningsAsErrors=false && \
    dotnet build src/Nexo.CLI/Nexo.CLI.csproj --no-restore -v minimal

# Default command: run base framework and Trust tests
CMD ["bash", "-c", "dotnet test src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj --filter 'FullyQualifiedName~BaseFrameworkSmokeTests' --logger 'console;verbosity=normal' && dotnet test src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj --filter 'FullyQualifiedName~Trust' --logger 'console;verbosity=normal' && dotnet test src/Nexo.Tests.BackgroundAgents/Nexo.Tests.BackgroundAgents.csproj --filter 'FullyQualifiedName~Trust' --logger 'console;verbosity=normal'"]
