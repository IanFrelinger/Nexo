# Dockerfile for running tests in Unity-compatible environment (Ubuntu + .NET SDK).
# Verifies Unity .NET Standard 2.0 builds and runs same test suites as other caching envs.
# Uses .NET 9 SDK to match solution TargetFrameworks (net8.0;net9.0).
ARG DOTNET_VERSION=9.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}

# Install dependencies
RUN apt-get update && \
    apt-get install -y \
        curl \
        git \
        python3 \
        python3-pip \
        && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Skip CopyAssemblies tool build in container (avoids targeting pack issues with scripts/copy-assemblies)
ENV DOTNET_RUNNING_IN_CONTAINER=true

# Copy project files
COPY . .

# Restore dependencies for test projects + Unity-compatible projects (GeospatialE2E omitted: requires GeoTerrainCommand)
RUN dotnet restore src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj && \
    dotnet restore src/Nexo.Tests.Infrastructure/scripts/copy-assemblies.csproj && \
    dotnet restore src/Nexo.Tests.BackgroundAgents/Nexo.Tests.BackgroundAgents.csproj && \
    dotnet restore src/Nexo.Core.UI.Unity/Nexo.Core.UI.Unity.csproj && \
    dotnet restore src/Nexo.Tests.Domain/Nexo.Tests.Domain.csproj

# Build test projects for net9.0 + Unity projects (TreatWarningsAsErrors=false for Docker/CI portability)
RUN dotnet build src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj -f net9.0 --no-restore -p:TreatWarningsAsErrors=false && \
    dotnet build src/Nexo.Tests.BackgroundAgents/Nexo.Tests.BackgroundAgents.csproj -f net9.0 --no-restore -p:TreatWarningsAsErrors=false && \
    dotnet build src/Nexo.Core.UI.Unity/Nexo.Core.UI.Unity.csproj --no-restore -p:TreatWarningsAsErrors=false && \
    dotnet build src/Nexo.Tests.Domain/Nexo.Tests.Domain.csproj --no-restore -p:TreatWarningsAsErrors=false

# Default command: run base framework smoke tests + Trust tests (Unity-compatible)
CMD ["bash", "-c", "dotnet test src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj --filter 'FullyQualifiedName~BaseFrameworkSmokeTests' --logger 'console;verbosity=normal' && dotnet test src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj --filter 'FullyQualifiedName~Trust' --logger 'console;verbosity=normal' && dotnet test src/Nexo.Tests.BackgroundAgents/Nexo.Tests.BackgroundAgents.csproj --filter 'FullyQualifiedName~Trust' --logger 'console;verbosity=normal'"]
