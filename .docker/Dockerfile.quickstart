# All-in-one Nexo quickstart image: API + portal + mock provider enabled.
# Usage:
#   docker build -f .docker/Dockerfile.quickstart -t nexo:latest .
#   docker run --rm -p 127.0.0.1:8080:8080 nexo:latest
#   Open http://localhost:8080
# No auth in this image: publish on 0.0.0.0 only behind auth + TLS (README.md "Security Defaults").
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore application/src/Nexo.API/Nexo.API.csproj
RUN dotnet publish application/src/Nexo.API/Nexo.API.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish ./

# Runtime state (LiteDB stores, snapshots) and dailies live under /data so they survive container
# recreation when a volume is mounted there (docs/DEPLOYMENT.md, "Runtime state"). /app stays
# root-owned and read-only for the non-root user below.
ENV ASPNETCORE_URLS=http://+:8080 \
    NEXO_ALLOW_MOCK=1 \
    DOTNET_NOLOGO=true \
    NEXO_STATE_DIR=/data/state \
    NEXO_DAILIES_PATH=/data/dailies \
    NEXO_FORGE_ROOT=/data/state/runtime-studio/forge \
    NEXO_OBJECTIVES_ROOT=/data/state/runtime-studio/objectives \
    NEXO_OBSERVATIONS_PATH=/data/state/runtime-studio/observations
# Runtime-studio stores follow the same rule; anything that still defaults to <cwd>/.nexo gets a
# writable, non-persistent /app/.nexo instead of an UnauthorizedAccessException under the non-root user.
RUN mkdir -p /data/state/runtime-studio /data/dailies /app/.nexo /app/config && chown -R app:app /data /app/.nexo /app/config
EXPOSE 8080

# The aspnet image has no curl; probe /health with bash's /dev/tcp so the check can actually pass.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf "GET /health HTTP/1.0\r\nHost: localhost\r\n\r\n" >&3 && grep -q " 200 " <&3' || exit 1

# Non-root: the aspnet 8+ images ship an unprivileged 'app' user (numeric $APP_UID so k8s runAsNonRoot can verify it).
USER $APP_UID

ENTRYPOINT ["dotnet", "Nexo.API.dll"]
