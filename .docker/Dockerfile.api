FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore application/src/Nexo.API/Nexo.API.csproj
# Nexo.API multi-targets net8.0;net10.0 (net8.0 only for in-repo library consumers); the image ships net10.0.
RUN dotnet publish application/src/Nexo.API/Nexo.API.csproj -c Release -f net10.0 -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish ./

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "Nexo.API.dll"]
