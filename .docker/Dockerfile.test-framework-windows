# Dockerfile for running Ashlar framework tests on Windows
ARG DOTNET_VERSION=10.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-nanoserver-ltsc2022

# Set working directory
WORKDIR C:\workspace

# Copy solution and project files
COPY *.sln *.props *.json ./
COPY src\ .\src\
COPY coverage.runsettings .\

# Restore dependencies for framework test projects
RUN dotnet restore src\Ashlar.Tests.Domain\Ashlar.Tests.Domain.csproj && \
    dotnet restore src\Ashlar.Tests.Application\Ashlar.Tests.Application.csproj && \
    dotnet restore src\Ashlar.Tests.Infrastructure\Ashlar.Tests.Infrastructure.csproj && \
    dotnet restore src\Ashlar.Tests.Orchestration\Ashlar.Tests.Orchestration.csproj

# Build test projects
RUN dotnet build src\Ashlar.Tests.Domain\Ashlar.Tests.Domain.csproj --no-restore && \
    dotnet build src\Ashlar.Tests.Application\Ashlar.Tests.Application.csproj --no-restore && \
    dotnet build src\Ashlar.Tests.Infrastructure\Ashlar.Tests.Infrastructure.csproj --no-restore && \
    dotnet build src\Ashlar.Tests.Orchestration\Ashlar.Tests.Orchestration.csproj --no-restore

# Default command: run all framework tests
CMD ["cmd", "/c", "dotnet test src\\Ashlar.Tests.Domain\\Ashlar.Tests.Domain.csproj --logger \"console;verbosity=normal\" && dotnet test src\\Ashlar.Tests.Application\\Ashlar.Tests.Application.csproj --logger \"console;verbosity=normal\" && dotnet test src\\Ashlar.Tests.Infrastructure\\Ashlar.Tests.Infrastructure.csproj --logger \"console;verbosity=normal\" && dotnet test src\\Ashlar.Tests.Orchestration\\Ashlar.Tests.Orchestration.csproj --logger \"console;verbosity=normal\""]
