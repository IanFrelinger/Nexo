# Dockerfile for running Nexo framework tests in Unity-compatible environment
# Tests code analysis functionality in .NET Standard 2.0 compatible environment
# Uses .NET SDK image which already includes .NET 8.0
# This simulates Unity's .NET Standard 2.0 environment for testing
ARG DOTNET_VERSION=8.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}

# Install Python3 for assembly copying script
RUN apt-get update && apt-get install -y python3 && rm -rf /var/lib/apt/lists/*

# Verify .NET installation
RUN dotnet --version

# Set working directory
WORKDIR /workspace

# Copy solution and project files
COPY *.sln *.props *.json ./
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY coverage.runsettings ./

# Restore and build for .NET Standard 2.0 (Unity compatible)
# Also restore Infrastructure for code analysis tests and Agents for AI agent tests
RUN dotnet restore src/Nexo.Core.Domain/Nexo.Core.Domain.csproj && \
    dotnet restore src/Nexo.Core.UI.Unity/Nexo.Core.UI.Unity.csproj && \
    dotnet restore src/Nexo.Tests.Domain/Nexo.Tests.Domain.csproj && \
    dotnet restore src/Nexo.Infrastructure/Nexo.Infrastructure.csproj && \
    dotnet restore src/Nexo.Agents.AutonomousDev/Nexo.Agents.AutonomousDev.csproj && \
    dotnet restore src/Nexo.Agents.UniversalTester/Nexo.Agents.UniversalTester.csproj && \
    dotnet restore src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj

# Build for .NET Standard 2.0 to verify Unity compatibility
# Build Infrastructure for code analysis (targets net8.0 but uses .NET Standard 2.0 compatible APIs)
# Build Agents for AI agent tests (targets net8.0 but uses portable APIs)
RUN dotnet build src/Nexo.Core.Domain/Nexo.Core.Domain.csproj \
        --framework netstandard2.0 \
        --no-restore && \
    dotnet build src/Nexo.Core.UI.Unity/Nexo.Core.UI.Unity.csproj \
        --no-restore && \
    dotnet build src/Nexo.Infrastructure/Nexo.Infrastructure.csproj \
        --no-restore && \
    dotnet build src/Nexo.Agents.AutonomousDev/Nexo.Agents.AutonomousDev.csproj \
        --no-restore && \
    dotnet build src/Nexo.Agents.UniversalTester/Nexo.Agents.UniversalTester.csproj \
        --no-restore && \
    dotnet build src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj \
        --no-restore

# Run framework tests that are Unity-compatible
# Phase 1: Base Framework Smoke Tests (includes code analysis and AI agent tests)
# Phase 2: Code Analysis Platform Compatibility Tests
# Phase 3: AI Agent Platform Compatibility Tests
# Phase 4: Domain tests (Unity-compatible)
CMD ["bash", "-c", "echo '✅ Core.Domain is Unity-compatible (.NET Standard 2.0)' && echo '🧪 Running Base Framework Smoke Tests (includes code analysis and AI agents)...' && dotnet test src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj --filter 'FullyQualifiedName~BaseFrameworkSmokeTests' --logger 'console;verbosity=minimal' && echo '🧪 Running Code Analysis Platform Compatibility Tests...' && dotnet test src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj --filter 'FullyQualifiedName~CodeAnalysisPlatformCompatibilityTests' --logger 'console;verbosity=minimal' && echo '🧪 Running AI Agent Platform Compatibility Tests...' && dotnet test src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj --filter 'FullyQualifiedName~AgentPlatformCompatibilityTests' --logger 'console;verbosity=minimal' && dotnet test src/Nexo.Tests.Domain/Nexo.Tests.Domain.csproj --framework netstandard2.0 --logger 'console;verbosity=minimal' && echo '✅ Unity compatibility tests completed (including code analysis and AI agents)'"]
