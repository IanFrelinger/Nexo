# Dockerfile for running Nexo framework tests in Unity-compatible environment
# Uses .NET Standard 2.0 to match Unity's runtime requirements
ARG DOTNET_VERSION=8.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}

# Install dependencies
RUN apt-get update && \
    apt-get install -y \
    curl \
    git \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Unity (headless version for testing)
# Unity Hub CLI or Unity Editor can be installed here
# For now, we'll test .NET Standard 2.0 compatibility

# Set working directory
WORKDIR /workspace

# Copy solution and project files
COPY *.sln *.props *.json ./
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY coverage.runsettings ./

# Restore and build for .NET Standard 2.0 (Unity compatible)
RUN dotnet restore src/Nexo.Core.Domain/Nexo.Core.Domain.csproj && \
    dotnet restore src/Nexo.Core.UI.Unity/Nexo.Core.UI.Unity.csproj && \
    dotnet restore src/Nexo.Tests.Domain/Nexo.Tests.Domain.csproj

# Build for .NET Standard 2.0 to verify Unity compatibility
RUN dotnet build src/Nexo.Core.Domain/Nexo.Core.Domain.csproj \
        --framework netstandard2.0 \
        --no-restore && \
    dotnet build src/Nexo.Core.UI.Unity/Nexo.Core.UI.Unity.csproj \
        --no-restore

# Run tests that are Unity-compatible
# Default command: test Unity compatibility
CMD ["bash", "-c", "dotnet build src/Nexo.Core.Domain/Nexo.Core.Domain.csproj --framework netstandard2.0 --no-restore && echo '✅ Core.Domain is Unity-compatible (.NET Standard 2.0)' && dotnet build src/Nexo.Core.UI.Unity/Nexo.Core.UI.Unity.csproj --no-restore && echo '✅ Unity UI components build successfully'"]
