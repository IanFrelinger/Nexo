# Dockerfile for running visual validation tests on Debian
ARG DOTNET_VERSION=8.0
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}

# Pure .NET rendering - no browser dependencies needed
# Only install curl for health checks
RUN apt-get update && \
    apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Copy solution and project files
COPY *.sln *.props *.json ./
COPY src/ ./src/
COPY scripts/ ./scripts/

# Restore dependencies
RUN dotnet restore src/Nexo.Tests.GeospatialVisual/Nexo.Tests.GeospatialVisual.csproj

# Build the test project
RUN dotnet build src/Nexo.Tests.GeospatialVisual/Nexo.Tests.GeospatialVisual.csproj --no-restore

# Run visual validation tests with pure .NET rendering
# No browser dependencies needed - uses ImageSharp + JeremyAnsel.Media.WavefrontObj
# Note: When using docker-compose, Ollama will be available at http://ollama:11434
CMD ["bash", "-c", "echo '🎨 Running Visual Validation Tests with Ollama (Debian, Pure .NET)...' && dotnet test src/Nexo.Tests.GeospatialVisual/Nexo.Tests.GeospatialVisual.csproj --filter 'FullyQualifiedName~GeospatialVisualValidationTests' --logger 'console;verbosity=detailed' && echo '✅ Visual validation tests completed'"]
