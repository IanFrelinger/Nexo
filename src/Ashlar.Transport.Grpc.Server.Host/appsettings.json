{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Ashlar": {
    "GrpcTransport": {
      "AllowInsecure": false,
      "MaxRetryAttempts": 3,
      "ClientCertPath": null,
      "ClientCertKeyPath": null,
      "CaCertPath": null
    }
  }
}
