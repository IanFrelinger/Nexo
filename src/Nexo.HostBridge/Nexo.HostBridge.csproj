<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>TCP NDJSON host-bridge client for Nexo agents and game runners.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexo.Abstractions\Nexo.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexo.Tests.HostBridge" />
  </ItemGroup>

</Project>
