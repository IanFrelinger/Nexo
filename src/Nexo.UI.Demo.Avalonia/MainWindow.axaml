<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nexo.UI.Demo.Avalonia.MainWindow"
        Title="Forge - Framework-Agnostic Design System | Avalonia Implementation"
        Width="1200" Height="800"
        MinWidth="1000" MinHeight="600"
        FontFamily="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="40" Margin="40">
      
      <!-- Header -->
      <Border Classes="demo-header">
        <StackPanel>
          <TextBlock Text="Framework-Agnostic Design System" 
                     Classes="heading-1" 
                     Foreground="White" 
                     HorizontalAlignment="Center"/>
          <TextBlock Text="Avalonia Implementation - Powered by Forge" 
                     Classes="body-large" 
                     Foreground="White" 
                     HorizontalAlignment="Center" 
                     Opacity="0.9"/>
        </StackPanel>
      </Border>

      <!-- Button Variants Section -->
      <Border Classes="section">
        <StackPanel Spacing="24">
          <TextBlock Text="Button Variants" Classes="heading-2"/>
          <TextBlock Text="Framework-agnostic button primitives with semantic variants and consistent styling across all platforms." 
                     Classes="body" 
                     Foreground="#666666"/>
          
          <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <Button Content="Primary - Default action" Classes="primary" MinWidth="200"/>
              <Button Content="Secondary - Alternative action" Classes="secondary" MinWidth="200"/>
              <Button Content="Success - Confirm action" Classes="success" MinWidth="200"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Spacing="16">
              <Button Content="Warning - Caution required" Classes="warning" MinWidth="200"/>
              <Button Content="Error - Destructive action" Classes="danger" MinWidth="200"/>
              <Button Content="Info - Informational" Classes="info" MinWidth="200"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Spacing="16">
              <Button Content="Disabled - Unavailable" IsEnabled="False" Classes="secondary" MinWidth="200"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Input Variants Section -->
      <Border Classes="section">
        <StackPanel Spacing="24">
          <TextBlock Text="Input Types &amp; States" Classes="heading-2"/>
          <TextBlock Text="Comprehensive input primitives with validation states, accessibility features, and consistent behavior." 
                     Classes="body" 
                     Foreground="#666666"/>
          
          <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,16,Auto,16,Auto">
            
            <!-- Row 1: Text Inputs -->
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
              <TextBlock Text="Text Input (Enabled)" Classes="body-small"/>
              <TextBox Watermark="Enter text..." Classes="body"/>
            </StackPanel>
            
            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="8">
              <TextBlock Text="Text Input (Disabled)" Classes="body-small"/>
              <TextBox Watermark="Disabled input" IsEnabled="False" Classes="body"/>
            </StackPanel>
            
            <!-- Row 2: Specialized Inputs -->
            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="8">
              <TextBlock Text="Password Input" Classes="body-small"/>
              <TextBox Watermark="Enter password..." PasswordChar="*" Classes="body"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="8">
              <TextBlock Text="Email Input" Classes="body-small"/>
              <TextBox Watermark="email@example.com" Classes="body"/>
            </StackPanel>
            
            <!-- Row 3: Validation States -->
            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="8">
              <TextBlock Text="Input with Error" Classes="body-small"/>
              <TextBox Watermark="Invalid input" Text="invalid@email" BorderBrush="#DC3545" Classes="body"/>
              <TextBlock Text="Please enter a valid email address" Classes="caption" Foreground="#DC3545"/>
            </StackPanel>
            
            <StackPanel Grid.Row="4" Grid.Column="2" Spacing="8">
              <TextBlock Text="Input with Success" Classes="body-small"/>
              <TextBox Watermark="Valid input" Text="user@example.com" BorderBrush="#28A745" Classes="body"/>
              <TextBlock Text="✓ Email address is valid" Classes="caption" Foreground="#28A745"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Card Variants Section -->
      <Border Classes="section">
        <StackPanel Spacing="24">
          <TextBlock Text="Card Layouts" Classes="heading-2"/>
          <TextBlock Text="Flexible card primitives with consistent spacing, typography, and interactive states." 
                     Classes="body" 
                     Foreground="#666666"/>
          
          <Grid ColumnDefinitions="*,24,*">
            
            <!-- Simple Card -->
            <Border Grid.Column="0" Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Simple Card" Classes="heading-3"/>
                <TextBlock Text="This is a simple card with title and content. It demonstrates the basic card primitive with consistent spacing and typography." 
                           Classes="body" 
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            
            <!-- Card with Footer -->
            <Border Grid.Column="2" Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Card with Footer" Classes="heading-3"/>
                <TextBlock Text="This card includes a footer section to show additional information or actions." 
                           Classes="body" 
                           TextWrapping="Wrap"/>
                <Border Background="#F8F9FA" 
                        CornerRadius="4" 
                        Padding="12" 
                        Margin="0,8,0,0">
                  <TextBlock Text="Footer content with additional details" Classes="caption"/>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
          
          <!-- Full-width Card -->
          <Border Classes="card">
            <StackPanel Spacing="16">
              <TextBlock Text="Full-Width Card with Multiple Sections" Classes="heading-3"/>
              <TextBlock Text="This demonstrates a more complex card layout with multiple content sections, showing the flexibility of the card primitive system." 
                         Classes="body" 
                         TextWrapping="Wrap"/>
              
              <Grid ColumnDefinitions="*,24,*">
                <StackPanel Grid.Column="0" Spacing="8">
                  <TextBlock Text="Features" Classes="body" FontWeight="SemiBold"/>
                  <TextBlock Text="• Framework-agnostic primitives" Classes="body-small"/>
                  <TextBlock Text="• Consistent design tokens" Classes="body-small"/>
                  <TextBlock Text="• Accessibility built-in" Classes="body-small"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Text="Benefits" Classes="body" FontWeight="SemiBold"/>
                  <TextBlock Text="• 80% code reuse across frameworks" Classes="body-small"/>
                  <TextBlock Text="• 20 hours → &lt;1 hour with automation" Classes="body-small"/>
                  <TextBlock Text="• Single source of truth" Classes="body-small"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Architecture Overview Section -->
      <Border Classes="section">
        <StackPanel Spacing="24">
          <TextBlock Text="Architecture Overview" Classes="heading-2"/>
          <TextBlock Text="Three-layer architecture enabling framework-agnostic pattern extraction and reuse." 
                     Classes="body" 
                     Foreground="#666666"/>
          
          <Grid ColumnDefinitions="*,24,*,24,*">
            
            <!-- Design Tokens -->
            <Border Grid.Column="0" Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Design Tokens" Classes="heading-3" Foreground="#0066CC"/>
                <TextBlock Text="Universal styling system with semantic colors, typography, and spacing tokens." 
                           Classes="body" 
                           TextWrapping="Wrap"/>
                <TextBlock Text="• 50+ semantic color tokens" Classes="body-small"/>
                <TextBlock Text="• Typography hierarchy" Classes="body-small"/>
                <TextBlock Text="• 4pt grid spacing system" Classes="body-small"/>
              </StackPanel>
            </Border>
            
            <!-- Primitives -->
            <Border Grid.Column="2" Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Primitives" Classes="heading-3" Foreground="#28A745"/>
                <TextBlock Text="Framework-agnostic UI components with business logic and behavior patterns." 
                           Classes="body" 
                           TextWrapping="Wrap"/>
                <TextBlock Text="• Button, Input, Card primitives" Classes="body-small"/>
                <TextBlock Text="• Variant system (Primary, Secondary, etc.)" Classes="body-small"/>
                <TextBlock Text="• Accessibility built-in" Classes="body-small"/>
              </StackPanel>
            </Border>
            
            <!-- Renderers -->
            <Border Grid.Column="4" Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Renderers" Classes="heading-3" Foreground="#FFC107"/>
                <TextBlock Text="Framework-specific implementations that translate primitives to native controls." 
                           Classes="body" 
                           TextWrapping="Wrap"/>
                <TextBlock Text="• Avalonia (XAML-based)" Classes="body-small"/>
                <TextBlock Text="• Unity (IMGUI-based)" Classes="body-small"/>
                <TextBlock Text="• Future: WPF, MAUI, Web" Classes="body-small"/>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Metrics Section -->
      <Border Classes="section">
        <StackPanel Spacing="24">
          <TextBlock Text="Key Metrics" Classes="heading-2"/>
          <TextBlock Text="Quantified impact of framework-agnostic pattern extraction." 
                     Classes="body" 
                     Foreground="#666666"/>
          
          <Grid ColumnDefinitions="*,24,*,24,*">
            
            <Border Grid.Column="0" Classes="card">
              <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="80%" Classes="heading-1" Foreground="#0066CC" HorizontalAlignment="Center"/>
                <TextBlock Text="Code Reuse" Classes="body" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Shared primitives and design tokens across frameworks" 
                           Classes="body-small" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
              </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Classes="card">
              <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="20h → &lt;1h" Classes="heading-1" Foreground="#28A745" HorizontalAlignment="Center"/>
                <TextBlock Text="Development Time" Classes="body" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Manual build vs AI automation projection" 
                           Classes="body-small" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
              </StackPanel>
            </Border>
            
            <Border Grid.Column="4" Classes="card">
              <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="$450K" Classes="heading-1" Foreground="#FFC107" HorizontalAlignment="Center"/>
                <TextBlock Text="Annual Savings" Classes="body" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="For 10-person development team" 
                           Classes="body-small" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Footer -->
      <Border Classes="demo-footer">
        <StackPanel Spacing="8">
          <TextBlock Text="Built with framework-agnostic patterns • Core.UI → Avalonia Renderer" 
                     Classes="body" 
                     HorizontalAlignment="Center"/>
          <TextBlock Text="This demo proves cross-framework pattern extraction works. Next: AI automation with Forge." 
                     Classes="caption" 
                     HorizontalAlignment="Center" 
                     Foreground="#666666"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Window>
