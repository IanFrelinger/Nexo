<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageId>Nexo.Core.UI.Avalonia</PackageId>
    <Version>1.0.0</Version>
    <Authors>Nexo Framework</Authors>
    <Description>Avalonia-specific UI primitives for the Nexo framework</Description>
    <PackageTags>ui;design-system;primitives;avalonia;nexo</PackageTags>
    <RepositoryUrl>https://github.com/nexo-ai/nexo</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Nexo.Core.UI/Nexo.Core.UI.csproj" />
  </ItemGroup>

</Project>
