<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Nexo.Client.Mobile.MainPage"
             Title="Nexo">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Nexo Client" Style="{StaticResource Headline}" />
            <Label Text="Connect to Nexo API to run agents, validate, and orchestrate." Style="{StaticResource SubHeadline}" />

            <Frame BorderColor="{StaticResource Primary}" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Server URL" FontAttributes="Bold" />
                    <Entry x:Name="ServerUrlEntry" Placeholder="http://localhost:5000" Keyboard="Url" />
                    <Button x:Name="SaveUrlBtn" Text="Save URL" Clicked="OnSaveUrlClicked" />
                </VerticalStackLayout>
            </Frame>

            <Label x:Name="StatusLabel" Text="Status: Not connected" />
            <Button x:Name="StatusBtn" Text="Check Status" Clicked="OnStatusClicked" />

            <BoxView HeightRequest="1" Color="Gray" />
            <Label Text="Commands" FontAttributes="Bold" />
            <Button x:Name="ValidateBtn" Text="Run Validation" Clicked="OnValidateClicked" />
            <Button x:Name="OrchestrateBtn" Text="Orchestrate" Clicked="OnOrchestrateClicked" />

            <Label x:Name="ResultLabel" Text="" LineBreakMode="WordWrap" MaximumWidthRequest="400" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
