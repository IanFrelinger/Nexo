<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Chain to the repo-root Directory.Build.props; MSBuild only auto-imports the nearest one. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <NexoIncludeDomainBrickGlobalUsing Condition="
      '$(MSBuildProjectName)' == 'Nexo.Infrastructure' OR
      '$(MSBuildProjectName)' == 'Nexo.Core.Application' OR
      '$(MSBuildProjectName)' == 'Nexo.Hosting' OR
      '$(MSBuildProjectName)' == 'Nexo.BackgroundAgents' OR
      '$(MSBuildProjectName)' == 'Nexo.Authoring' OR
      '$(MSBuildProjectName)' == 'Nexo.Framework.Sdk' OR
      '$(MSBuildProjectName)' == 'Nexo.BackgroundAgents' OR
      '$(MSBuildProjectName)' == 'Nexo.Orchestration' OR
      '$(MSBuildProjectName)' == 'Nexo.Bricks.Owasp' OR
      '$(MSBuildProjectName)' == 'Nexo.Tests.Infrastructure' OR
      '$(MSBuildProjectName)' == 'Nexo.Tests.Application' OR
      '$(MSBuildProjectName)' == 'Nexo.Tests.Domain' OR
      '$(MSBuildProjectName)' == 'Nexo.Tests.Kernel' OR
      '$(MSBuildProjectName)' == 'Nexo.CLI' OR
      '$(MSBuildProjectName)' == 'Nexo.API' OR
      '$(MSBuildProjectName)' == 'GameDirector.Mcp' OR
      '$(MSBuildProjectName)' == 'GameDirector.Bricks' OR
      '$(MSBuildProjectName)' == 'GameDirector.Agents' OR
      '$(MSBuildProjectName)' == 'Nexo.Commercial.GameDomain' OR
      '$(MSBuildProjectName)' == 'Nexo.Commercial.Fleet.Infrastructure' OR
      '$(MSBuildProjectName)' == 'Nexo.Commercial.Fleet.Contracts' OR
      '$(MSBuildProjectName)' == 'Nexo.Commercial.Tests.Fleet' OR
      '$(MSBuildProjectName)' == 'Nexo.Tests.GameDirector' OR
      '$(MSBuildProjectName)' == 'HelloBrick' OR
      '$(MSBuildProjectName)' == 'Nexo.Certified.DamageResolver'
      ">true</NexoIncludeDomainBrickGlobalUsing>
  </PropertyGroup>

  <ItemGroup Condition="'$(NexoIncludeDomainBrickGlobalUsing)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)../build/GlobalUsings.DomainBrick.cs" Link="GlobalUsings.DomainBrick.cs" />
  </ItemGroup>
</Project>
