<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Chain to the repo-root Directory.Build.props; MSBuild only auto-imports the nearest one. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <AshlarIncludeDomainBrickGlobalUsing Condition="
      '$(MSBuildProjectName)' == 'Ashlar.Infrastructure' OR
      '$(MSBuildProjectName)' == 'Ashlar.Core.Application' OR
      '$(MSBuildProjectName)' == 'Ashlar.Hosting' OR
      '$(MSBuildProjectName)' == 'Ashlar.BackgroundAgents' OR
      '$(MSBuildProjectName)' == 'Ashlar.Authoring' OR
      '$(MSBuildProjectName)' == 'Ashlar.Framework.Sdk' OR
      '$(MSBuildProjectName)' == 'Ashlar.BackgroundAgents' OR
      '$(MSBuildProjectName)' == 'Ashlar.Orchestration' OR
      '$(MSBuildProjectName)' == 'Ashlar.Bricks.Owasp' OR
      '$(MSBuildProjectName)' == 'Ashlar.Tests.Infrastructure' OR
      '$(MSBuildProjectName)' == 'Ashlar.Tests.Application' OR
      '$(MSBuildProjectName)' == 'Ashlar.Tests.Domain' OR
      '$(MSBuildProjectName)' == 'Ashlar.Tests.Kernel' OR
      '$(MSBuildProjectName)' == 'Ashlar.CLI' OR
      '$(MSBuildProjectName)' == 'Ashlar.API' OR
      '$(MSBuildProjectName)' == 'GameDirector.Mcp' OR
      '$(MSBuildProjectName)' == 'GameDirector.Bricks' OR
      '$(MSBuildProjectName)' == 'GameDirector.Agents' OR
      '$(MSBuildProjectName)' == 'Ashlar.Commercial.GameDomain' OR
      '$(MSBuildProjectName)' == 'Ashlar.Commercial.Fleet.Infrastructure' OR
      '$(MSBuildProjectName)' == 'Ashlar.Commercial.Fleet.Contracts' OR
      '$(MSBuildProjectName)' == 'Ashlar.Commercial.Tests.Fleet' OR
      '$(MSBuildProjectName)' == 'Ashlar.Tests.GameDirector' OR
      '$(MSBuildProjectName)' == 'HelloBrick' OR
      '$(MSBuildProjectName)' == 'Ashlar.Certified.DamageResolver'
      ">true</AshlarIncludeDomainBrickGlobalUsing>
  </PropertyGroup>

  <ItemGroup Condition="'$(AshlarIncludeDomainBrickGlobalUsing)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Ashlar.Compat/GlobalUsings.DomainBrick.cs" Link="GlobalUsings.DomainBrick.cs" />
  </ItemGroup>
</Project>
