<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  
  <!-- Workaround for Castle.Core net6.0 assembly loading issue on .NET 8.0 -->
  <ItemGroup>
    <Content Include="Nexo.Tests.Infrastructure.runtimeconfig.template.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Nexo.Tests.Infrastructure.runtimeconfig.json</TargetPath>
    </Content>
  </ItemGroup>
  
  <!-- Import the targets file that handles copying assemblies -->
  <Import Project="$(MSBuildThisFileDirectory)CopyAssemblies.targets" />

  <!-- Exclude scripts directory from compilation -->
  <ItemGroup>
    <Compile Remove="scripts/**/*.cs" />
  </ItemGroup>
  <!-- Guide tests use Nexo.Guide (Avalonia, net8.0) -->

  <ItemGroup>
    <PackageReference Include="Moq" />
    <PackageReference Include="Castle.Core" />
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Docker.DotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexo.Core.Application\Nexo.Core.Application.csproj" />
    <ProjectReference Include="..\Nexo.Infrastructure\Nexo.Infrastructure.csproj" />
    <ProjectReference Include="..\Nexo.Orchestration\Nexo.Orchestration.csproj" />
    <ProjectReference Include="..\Nexo.Tests.Application\Nexo.Tests.Application.csproj" />
    <ProjectReference Include="..\Nexo.Demo.Bricks\Nexo.Demo.Bricks.csproj" />
    <ProjectReference Include="..\Nexo.Agents.UniversalTester\Nexo.Agents.UniversalTester.csproj" />
    <ProjectReference Include="..\Nexo.Agents.AutonomousDev\Nexo.Agents.AutonomousDev.csproj" />
    <ProjectReference Include="..\Nexo.Adapters.GeoTerrain\Nexo.Adapters.GeoTerrain.csproj" />
    <ProjectReference Include="..\Nexo.GeoTerrain.Bricks\Nexo.GeoTerrain.Bricks.csproj" />
    <ProjectReference Include="..\Nexo.Adapters.GeoVector\Nexo.Adapters.GeoVector.csproj" />
    <ProjectReference Include="..\Nexo.GeoVector.Bricks\Nexo.GeoVector.Bricks.csproj" />
    <ProjectReference Include="..\Nexo.SDK\Nexo.SDK.csproj" />
    <ProjectReference Include="..\Nexo.Guide\Nexo.Guide.csproj" />
  </ItemGroup>

</Project>

