<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Single TFM: parent tests multi-target (net8.0;net10.0) but this helper always builds as net10.0 (the pinned SDK's own TFM) so restore/build cannot fail with NETSDK1005 when assets.json lacks a TFM. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>copy-assemblies</AssemblyName>
  </PropertyGroup>
</Project>
