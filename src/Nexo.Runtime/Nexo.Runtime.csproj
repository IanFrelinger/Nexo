<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Nexo.Runtime</PackageId>
    <Title>Nexo Runtime</Title>
    <Description>Runtime routing, barrier enforcement, audit sinks, endpoint registry, and in-process agent execution primitives for Nexo.</Description>
    <PackageTags>nexo;runtime;agents;routing;barriers</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexo.Abstractions\Nexo.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\Nexo.Transport.Grpc\Nexo.Transport.Grpc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Nexo.Hosting" />
    <InternalsVisibleTo Include="Nexo.Infrastructure" />
    <InternalsVisibleTo Include="Nexo.BackgroundAgents" />
    <InternalsVisibleTo Include="Nexo.BackgroundAgents.HostRunners" />
    <InternalsVisibleTo Include="Nexo.CLI" />
    <InternalsVisibleTo Include="Nexo.Tests.Infrastructure" />
    <InternalsVisibleTo Include="Nexo.Tests.BackgroundAgents" />
    <InternalsVisibleTo Include="Nexo.Tests.Transport" />
    <InternalsVisibleTo Include="Nexo.Tests.Orchestration" />
  </ItemGroup>
</Project>
