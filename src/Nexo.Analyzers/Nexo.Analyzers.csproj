<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers must target netstandard2.0: that is what the compiler loads. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Packable as an ordinary library: Nexo.Infrastructure consumes this assembly at
         RUNTIME (AnalyzerFenceGate instantiates the catalog), so the packed hosting graph
         needs it in the local feed. In-repo projects additionally attach it in the
         analyzer role via ProjectReference; package consumers only need the library. -->
    <IsPackable>true</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <PackageId>Nexo.Analyzers</PackageId>
    <Title>Nexo Trust-Loop Analyzers</Title>
    <Description>Roslyn rules for Nexo brick code: contract drift, constructor purity, determinism, and the certification analyzer-gate catalog.</Description>
    <PackageTags>nexo;analyzers;roslyn;trust-loop;certification</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- netstandard2.0 leg of the contracts package. Safe for the build-time analyzer role:
         the only type using it (BrickConstraintManifestAnalyzer) carries no [DiagnosticAnalyzer]
         attribute, so compiler discovery never instantiates it — it is constructed
         programmatically by the certification gate WITH a manifest instance (spec A2.3:
         the manifest object itself is the single source, used twice).
         Consumers reference THIS project with UndefineProperties="TargetFramework" so a
         host's global -p:TargetFramework (e.g. the CLI image) never reaches this
         netstandard2.0-only subtree; nearest-TF negotiation then picks the contracts
         package's ns2.0 leg here normally. -->
    <ProjectReference Include="..\Nexo.Brick.Contracts\Nexo.Brick.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
