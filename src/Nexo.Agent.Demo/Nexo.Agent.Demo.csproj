    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexo.Agent\Nexo.Agent.csproj" />
    <ProjectReference Include="..\Nexo.Agent.Tools.Builtin\Nexo.Agent.Tools.Builtin.csproj" />
    <ProjectReference Include="..\Nexo.Observability\Nexo.Observability.csproj" />
  </ItemGroup>

</Project>
