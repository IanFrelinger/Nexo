{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Nexo": {
    "PatternStorePath": null,
    "GrpcTransport": {
      "AllowInsecure": false,
      "MaxRetryAttempts": 3,
      "ClientCertPath": "/run/secrets/client.crt",
      "ClientCertKeyPath": "/run/secrets/client.key",
      "CaCertPath": "/run/secrets/ca.crt"
    },
    "Barriers": {
      "Levels": [ "public", "internal", "confidential", "restricted" ],
      "RequireExplicitBarrier": true,
      "HostCeiling": "confidential"
    },
    "Security": {
      "ExposureProfile": "Localhost",
      "RequireApiKeyForMutatingEndpoints": false,
      "ApiKeyHeaderName": "X-Nexo-Api-Key",
      "ApiKey": null,
      "ExcludedApiKeyPaths": [],
      "AuthorizationMode": "None",
      "AuthorizationScope": "MutatingApi",
      "BearerTokenHeaderName": "Authorization",
      "BearerTokenScheme": "Bearer",
      "BearerToken": null,
      "BasicAuthHeaderName": "Authorization",
      "BasicAuthUsername": null,
      "BasicAuthPassword": null,
      "ExcludedAuthorizationPaths": [],
      "CustomAdvisory": null,
      "ShowAdvisoryInPortal": true
    },
    "Routing": {
      "Endpoints": [],
      "HealthCheckIntervalSeconds": 30
    }
  }
}
