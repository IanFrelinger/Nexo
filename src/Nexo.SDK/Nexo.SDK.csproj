<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Nexo.SDK</PackageId>
    <Version>1.0.0</Version>
    <Authors>Nexo</Authors>
    <Description>Programmatic SDK for Nexo geospatial operations</Description>
    <PackageTags>nexo;geospatial;terrain;vector;world</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexo.GeoTerrain\Nexo.GeoTerrain.csproj" />
    <ProjectReference Include="..\Nexo.GeoVector\Nexo.GeoVector.csproj" />
    <ProjectReference Include="..\Nexo.GeoWorld\Nexo.GeoWorld.csproj" />
    <ProjectReference Include="..\Nexo.Adapters.GeoTerrain\Nexo.Adapters.GeoTerrain.csproj" />
    <ProjectReference Include="..\Nexo.Adapters.GeoVector\Nexo.Adapters.GeoVector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
