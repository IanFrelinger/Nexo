  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexo.Spike.S0\Nexo.Spike.S0.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures/**/*.cs" />
    <None Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
