<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Nexo.Guide.Views.Controls"
        xmlns:vm="clr-namespace:Nexo.Guide.ViewModels"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="Nexo.Guide.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Nexo Guide"
        Width="1000" Height="700"
        Background="#FF000000"
        Classes="background">

	<Grid RowDefinitions="52,*">
		<!-- Title bar -->
		<Border Grid.Row="0" Background="#FF0D0D0D" Padding="20,0">
			<Grid ColumnDefinitions="Auto,*,Auto">
				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<Ellipse Width="12" Height="12" Fill="#FF5F57" />
					<Ellipse Width="12" Height="12" Fill="#FEBC2E" />
					<Ellipse Width="12" Height="12" Fill="#28C840" />
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
					<TextBlock Text="Nexo Guide" FontSize="13" FontWeight="Bold" Foreground="#FFF5F5F7" />
					<StackPanel Orientation="Horizontal" Spacing="5">
						<Ellipse Width="5" Height="5" Fill="#6EE7B7" Opacity="0.8" VerticalAlignment="Center" />
						<TextBlock Text="{Binding ModelName}" FontSize="11" Foreground="#4DFFFFFF" />
					</StackPanel>
				</StackPanel>
				<Border Grid.Column="2" Width="54" />
			</Grid>
		</Border>

		<Grid Grid.Row="1" ColumnDefinitions="200,*">
			<!-- Sidebar -->
			<Border Grid.Column="0" Background="#FF0D0D0D" Padding="8,12">
				<Grid RowDefinitions="Auto,Auto,*,Auto">
					<StackPanel Grid.Row="0" Spacing="0" Margin="0,0,0,24">
						<TextBlock Text="NAVIGATE" Classes="sidebar-heading" />
						<controls:SidebarItem automation:AutomationProperties.AutomationId="NavChat" Icon="○" Text="Chat" IsActive="{Binding IsChatPageActive}" Command="{Binding NavigateToChatCommand}" />
						<controls:SidebarItem automation:AutomationProperties.AutomationId="NavArchitecture" Icon="◇" Text="Architecture" IsActive="{Binding IsArchPageActive}" Command="{Binding NavigateToArchCommand}" />
					</StackPanel>
					<StackPanel Grid.Row="1" Spacing="0" Margin="0,0,0,24">
						<TextBlock Text="TOPICS COVERED" Classes="sidebar-heading" />
						<ItemsControl ItemsSource="{Binding TopicsCovered}" Margin="0,4,0,0">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid ColumnDefinitions="20,*" Margin="10,4">
										<TextBlock Grid.Column="0" Text="✓" FontSize="10" Foreground="#6EE7B7" Opacity="0.5" HorizontalAlignment="Center" />
										<TextBlock Grid.Column="1" Text="{Binding}" FontSize="11" Foreground="#4DFFFFFF" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
					<StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="10">
						<StackPanel Spacing="2">
						<TextBlock Text="localhost:11434" FontSize="10" Foreground="#4DFFFFFF" />
						<TextBlock Text="{Binding BrickCount, StringFormat={}{0} bricks registered}" FontSize="10" Foreground="#4DFFFFFF" />
						<TextBlock Text="1 agent active" FontSize="10" Foreground="#4DFFFFFF" />
					</StackPanel>
					</StackPanel>
				</Grid>
			</Border>

			<!-- Content -->
			<Grid Grid.Column="1">
				<!-- Chat page -->
				<StackPanel IsVisible="{Binding IsChatPageActive}" Margin="24,14,24,0">
					<controls:AudienceSelector SelectedAudience="{Binding Audience}" Margin="0,0,0,10" />
					<ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,20">
						<ItemsControl ItemsSource="{Binding Messages}" Margin="0,0,0,20">
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="vm:ChatMessage">
									<controls:ChatBubble Margin="0,0,0,20" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
					<controls:TypingIndicator IsVisible="{Binding IsTyping}" Margin="0,0,0,12" />
					<controls:SuggestedQuestions Questions="{Binding Suggestions}" SendCommand="{Binding SendSuggestionCommand}" IsVisible="{Binding HasSuggestions}" Margin="0,0,0,8" />
					<Border Background="#FF161616" CornerRadius="14" Padding="18,4,4,4" Margin="0,10,0,20" BorderBrush="#1AFFFFFF" BorderThickness="0.5">
						<Grid ColumnDefinitions="*,Auto">
							<TextBox automation:AutomationProperties.AutomationId="ChatInput" Grid.Column="0" Text="{Binding InputText}" Watermark="Ask about Nexo..." Foreground="#FFF5F5F7" FontSize="14" Background="Transparent" BorderThickness="0" MinHeight="36" />
							<Button automation:AutomationProperties.AutomationId="SendButton" Grid.Column="1" Command="{Binding SendMessageCommand}" Content="↑" FontSize="16" Foreground="#FF0D0D0D" Background="#FFF5F5F7" CornerRadius="10" Width="32" Height="32" Margin="4,0,0,0" />
						</Grid>
					</Border>
				</StackPanel>

				<!-- Architecture page -->
				<ScrollViewer IsVisible="{Binding IsArchPageActive}" Padding="24">
					<StackPanel Spacing="0">
						<TextBlock Text="Architecture" FontSize="16" FontWeight="Bold" Foreground="#FFF5F5F7" Margin="0,0,0,20" />
						<controls:LayerCard LayerName="Agents" LayerColor="#6EE7B7" Description="Autonomous entities with state and decision-making." BackgroundOpacity="0.04" />
						<controls:LayerCard LayerName="Behaviors" LayerColor="#34D399" Description="Composed workflows — directed acyclic graphs of bricks." BackgroundOpacity="0.03" Margin="0,2,0,0" />
						<controls:LayerCard LayerName="Bricks" LayerColor="#10B981" Description="Atomic capabilities: deterministic or agentic." BackgroundOpacity="0.03" Margin="0,2,0,0" />
						<TextBlock Text="THIS GUIDE'S PIPELINE" Classes="sidebar-heading" Margin="0,28,0,12" />
						<controls:BrickPipeline Bricks="{Binding GuideBricks}" />
						<TextBlock Text="DUAL IMPLEMENTATION MODES" Classes="sidebar-heading" Margin="0,28,0,12" />
						<Grid ColumnDefinitions="*,*" Margin="0,0,0,8">
							<controls:ModeCard Grid.Column="0" Mode="⚙️ Deterministic" Description="Predictable, testable, fast." />
							<controls:ModeCard Grid.Column="1" Mode="🤖 Agentic" Description="Flexible, adaptive, intelligent." />
						</Grid>
						<TextBlock Text="KEY INSIGHT" Classes="sidebar-heading" Margin="0,28,0,12" />
						<TextBlock Text="Any brick can be swapped between modes at runtime. Same framework, same code, one toggle."
							FontSize="13" Foreground="#8CFFFFFF" Margin="0,0,0,20" TextWrapping="Wrap" />
					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Grid>
</Window>
