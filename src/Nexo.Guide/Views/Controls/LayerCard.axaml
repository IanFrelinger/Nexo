<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexo.Guide.Views.Controls.LayerCard">
	<Border x:Name="Container" Padding="18,14" CornerRadius="10" BorderThickness="0.5" BorderBrush="Transparent">
		<StackPanel>
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Ellipse x:Name="Dot" Width="6" Height="6" VerticalAlignment="Center" />
				<TextBlock x:Name="NameLabel" FontSize="14" FontWeight="Bold" Foreground="#FFF5F5F7" />
			</StackPanel>
			<TextBlock x:Name="DescLabel" FontSize="12" Foreground="#8CFFFFFF" LineHeight="1.5" Margin="0,6,0,0" IsVisible="False" />
		</StackPanel>
	</Border>
</UserControl>
