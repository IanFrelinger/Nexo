<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nexo.Guide.Views.Controls.SidebarItem">
	<Border x:Name="Container" Padding="10,7" CornerRadius="7" BorderThickness="0" Background="Transparent">
		<Grid ColumnDefinitions="20,*">
			<TextBlock x:Name="IconLabel" Grid.Column="0" FontSize="15" Foreground="#8CFFFFFF" Opacity="0.7" HorizontalAlignment="Center" />
			<TextBlock x:Name="TextLabel" Grid.Column="1" FontSize="13" Foreground="#8CFFFFFF" Margin="8,0,0,0" />
		</Grid>
	</Border>
</UserControl>
