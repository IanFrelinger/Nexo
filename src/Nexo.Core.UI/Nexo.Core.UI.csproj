<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageId>Nexo.Core.UI</PackageId>
    <Version>1.0.0</Version>
    <Authors>Nexo Framework</Authors>
    <Description>Core UI primitives and design system for the Nexo framework</Description>
    <PackageTags>ui;design-system;primitives;nexo</PackageTags>
    <RepositoryUrl>https://github.com/nexo-ai/nexo</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

</Project>
