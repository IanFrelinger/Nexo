<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Metapackage: one PackageReference for consumers embedding Nexo.Hosting from NuGet.
    Pack after the hosting graph (scripts/pack-nexo-hosting-graph.*) so all Nexo.* versions exist on the feed.
    Pack with: dotnet pack -p:PackageVersion=1.2.3 (same version as graph packages).
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageId>Nexo.Hosting.Bundle</PackageId>
    <Title>Nexo Hosting (bundle)</Title>
    <Description>Metapackage that pulls the full Nexo.Hosting dependency graph at a single version. Prefer this over referencing only Nexo.Hosting when consuming from nuget.org.</Description>
    <PackageTags>nexo;hosting;metapackage</PackageTags>
    <RepositoryUrl>https://github.com/IanFrelinger/Nexo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Nexo.Abstractions" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Core.Domain" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Core.Application" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Brick.Contracts" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Policies" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Tools.Assembly" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Tools.Dev" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Transport.Grpc" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Runtime" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Certification.Contracts" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Infrastructure" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Orchestration" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.BackgroundAgents" Version="$(PackageVersion)" />
    <PackageReference Include="Nexo.Hosting" Version="$(PackageVersion)" />
  </ItemGroup>
</Project>
