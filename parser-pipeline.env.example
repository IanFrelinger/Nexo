# Copy to $WORKSPACE_ROOT/parser-pipeline.env (or pass --env-file) when
# default ports are already in use — or just run:
#   bash scripts/setup-parser-pipeline.sh
#
# Paths must be absolute and match THIS machine's user/home. Do not copy
# another developer's /home/<name>/... values.

EVTX_HOST_PORT=28080
AGENT_PORT=15237
GUI_PORT=15237

# Required for the extract-agent profile (set to your paths):
# WORKSPACE_ROOT=/home/YOU/work
# POCO_CONTEXT=/home/YOU/work/poco
# NEXO_ROOT=/home/YOU/work/nexo
# PARSER_PIPELINE_COMPOSE=/home/YOU/work/nexo/docker-compose.parser-pipeline.yml
# COMPOSE_PROJECT=nexo-parser-pipeline

# After Install + rebuild, setup/agent may set:
# EVTX_IMAGE=evtx:custom
