<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Spike: deliberately outside Nexo.sln and every CI gate. Its output is a run
         recorded in docs/certification-evidence.md, not a shipped artifact. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The repo-wide DomainBrick alias arrives via per-tree Directory.Build.props;
         spikes/ has none, so include the shared global-usings file directly. -->
    <Compile Include="..\..\..\build\GlobalUsings.DomainBrick.cs" Link="GlobalUsings.DomainBrick.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Nexo.Infrastructure\Nexo.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Nexo.BackgroundAgents\Nexo.BackgroundAgents.csproj" />
    <ProjectReference Include="..\..\..\src\Nexo.Agents.TestKit\Nexo.Agents.TestKit.csproj" />
    <ProjectReference Include="../../../applications/Nexo.Certification.Physical/Nexo.Certification.Physical.csproj" />
  </ItemGroup>

</Project>
