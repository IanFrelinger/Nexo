<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Spike: deliberately outside Ashlar.sln and every CI gate. Its output is a run
         recorded in docs/certification-evidence.md, not a shipped artifact. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- This spike IS the consumer of the experimental autonomy surface (harness, loop, proposal
         sources); ASHLAREXP001 is an error by design for everyone else - see docs/SdkCompatibilityPolicy.md. -->
    <NoWarn>$(NoWarn);ASHLAREXP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The repo-wide DomainBrick alias arrives via per-tree Directory.Build.props;
         spikes/ has none, so include the shared global-usings file directly. -->
    <Compile Include="..\..\..\src\Ashlar.Compat\GlobalUsings.DomainBrick.cs" Link="GlobalUsings.DomainBrick.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Ashlar.Infrastructure\Ashlar.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Ashlar.BackgroundAgents\Ashlar.BackgroundAgents.csproj" />
    <ProjectReference Include="..\..\..\src\Ashlar.Agents.TestKit\Ashlar.Agents.TestKit.csproj" />
    <ProjectReference Include="../../../applications/Ashlar.Certification.Physical/Ashlar.Certification.Physical.csproj" />
  </ItemGroup>

</Project>
