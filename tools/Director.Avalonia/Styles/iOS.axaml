<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Base Typography Styles - Improved for Readability -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
    <Setter Property="LineHeight" Value="1.6"/>
  </Style>

  <!-- Typography Hierarchy - Much Larger, More Readable Sizes -->
  <Style Selector="TextBlock.heading-1">
    <Setter Property="FontSize" Value="32"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LineHeight" Value="1.3"/>
    <Setter Property="Margin" Value="0,0,0,24"/>
    <Setter Property="Foreground" Value="#000000"/>
  </Style>

  <Style Selector="TextBlock.heading-2">
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LineHeight" Value="1.4"/>
    <Setter Property="Margin" Value="0,0,0,20"/>
    <Setter Property="Foreground" Value="#000000"/>
  </Style>

  <Style Selector="TextBlock.heading-3">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LineHeight" Value="1.4"/>
    <Setter Property="Margin" Value="0,0,0,16"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
  </Style>

  <Style Selector="TextBlock.body-large">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="LineHeight" Value="1.6"/>
    <Setter Property="Margin" Value="0,0,0,16"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="LineHeight" Value="1.6"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
  </Style>

  <Style Selector="TextBlock.body-small">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="LineHeight" Value="1.6"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="#666666"/>
    <Setter Property="LineHeight" Value="1.5"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="SFMono-Regular, 'SF Mono', Consolas, 'Liberation Mono', Menlo, monospace"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="LineHeight" Value="1.5"/>
  </Style>

  <!-- Button Base Style - Much Larger, More Readable -->
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="MinHeight" Value="52"/>
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="Padding" Value="24,16"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>

  <!-- Button Variants - High Contrast Colors -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#0066CC"/>
    <Setter Property="BorderBrush" Value="#0066CC"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="#0052A3"/>
    <Setter Property="BorderBrush" Value="#0052A3"/>
  </Style>
  <Style Selector="Button.primary:pressed">
    <Setter Property="Background" Value="#003D7A"/>
    <Setter Property="BorderBrush" Value="#003D7A"/>
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#CCCCCC"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
  </Style>
  <Style Selector="Button.secondary:pointerover">
    <Setter Property="Background" Value="#F5F5F5"/>
    <Setter Property="BorderBrush" Value="#0066CC"/>
  </Style>
  <Style Selector="Button.secondary:pressed">
    <Setter Property="Background" Value="#E8E8E8"/>
    <Setter Property="BorderBrush" Value="#0066CC"/>
  </Style>

  <Style Selector="Button.success">
    <Setter Property="Background" Value="#28A745"/>
    <Setter Property="BorderBrush" Value="#28A745"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.success:pointerover">
    <Setter Property="Background" Value="#218838"/>
    <Setter Property="BorderBrush" Value="#218838"/>
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#DC3545"/>
    <Setter Property="BorderBrush" Value="#DC3545"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="#C82333"/>
    <Setter Property="BorderBrush" Value="#C82333"/>
  </Style>

  <Style Selector="Button.warning">
    <Setter Property="Background" Value="#FFC107"/>
    <Setter Property="BorderBrush" Value="#FFC107"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
  </Style>
  <Style Selector="Button.warning:pointerover">
    <Setter Property="Background" Value="#E0A800"/>
    <Setter Property="BorderBrush" Value="#E0A800"/>
  </Style>

  <Style Selector="Button.info">
    <Setter Property="Background" Value="#17A2B8"/>
    <Setter Property="BorderBrush" Value="#17A2B8"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.info:pointerover">
    <Setter Property="Background" Value="#138496"/>
    <Setter Property="BorderBrush" Value="#138496"/>
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Background" Value="#F5F5F5"/>
    <Setter Property="BorderBrush" Value="#E0E0E0"/>
    <Setter Property="Foreground" Value="#999999"/>
    <Setter Property="Opacity" Value="0.7"/>
  </Style>

  <!-- TextBox Styles - Much Larger, More Readable -->
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="MinHeight" Value="52"/>
    <Setter Property="Padding" Value="20,16"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#CCCCCC"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="#0066CC"/>
    <Setter Property="Background" Value="White"/>
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Background" Value="#F5F5F5"/>
    <Setter Property="BorderBrush" Value="#E0E0E0"/>
    <Setter Property="Foreground" Value="#999999"/>
  </Style>

  <!-- ComboBox Styles - Much Larger, More Readable -->
  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="MinHeight" Value="52"/>
    <Setter Property="Padding" Value="20,16"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#CCCCCC"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
  </Style>
  <Style Selector="ComboBox:focus">
    <Setter Property="BorderBrush" Value="#0066CC"/>
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Padding" Value="20,16"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
  </Style>
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="#F5F5F5"/>
  </Style>
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="#0066CC"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- CheckBox (Switch) Styles - Larger -->
  <Style Selector="CheckBox.switch">
    <Setter Property="Width" Value="60"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Background" Value="#E0E0E0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="CheckBox.switch:checked">
    <Setter Property="Background" Value="#0066CC"/>
  </Style>

  <!-- Card Styles - Better Spacing -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#E0E0E0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="24"/>
    <Setter Property="Margin" Value="0,0,0,20"/>
    <Setter Property="Effect">
      <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="12" OffsetX="0" OffsetY="4"/>
    </Setter>
  </Style>

  <!-- Status Indicator - Larger -->
  <Style Selector="Ellipse.status-indicator">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Fill" Value="#DC3545"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.3"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Ellipse.status-indicator.connected">
    <Setter Property="Fill" Value="#28A745"/>
  </Style>

  <!-- TabControl Styles - More Readable -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Padding" Value="20,16"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#666666"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TabItem:pointerover">
    <Setter Property="Background" Value="#F5F5F5"/>
    <Setter Property="Foreground" Value="#1A1A1A"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="#0066CC"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- Log Item Styles - Better Readability -->
  <Style Selector="Border.log-item">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#E0E0E0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="20,16"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Effect">
      <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="8" OffsetX="0" OffsetY="2"/>
    </Setter>
  </Style>

  <!-- Gate Item Styles - Better Readability -->
  <Style Selector="Border.gate-item">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#E0E0E0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="20,16"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Effect">
      <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="8" OffsetX="0" OffsetY="2"/>
    </Setter>
  </Style>

  <!-- Status Bar - Better Spacing -->
  <Style Selector="Border.status-bar">
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#E0E0E0"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="24,20"/>
    <Setter Property="Effect">
      <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="12" OffsetX="0" OffsetY="-4"/>
    </Setter>
  </Style>

  <!-- Window Styles - Better Background -->
  <Style Selector="Window">
    <Setter Property="Background" Value="#F8F9FA"/>
    <Setter Property="FontFamily" Value="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif"/>
  </Style>

</Styles>