{
  "targetSlot": "quality.filters",
  "uiSchema": {
    "elements": [
      {
        "type": "toolbarMenu",
        "text": "Status: All",
        "items": ["All", "Errors", "Warnings"],
        "onSelectionChanged": "OnStatusFilterChanged"
      },
      {
        "type": "toolbarToggle",
        "text": "Show Performance",
        "value": true,
        "onToggled": "OnPerformanceToggleChanged"
      },
      {
        "type": "button",
        "text": "Run Validation",
        "onClick": "OnValidationButtonClicked"
      },
      {
        "type": "slider",
        "text": "Quality Level",
        "minValue": 0,
        "maxValue": 5,
        "value": 3,
        "onValueChanged": "OnQualityLevelChanged"
      }
    ]
  }
}
