<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Director.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Director.Avalonia.Views.CodeModificationView"
             x:DataType="vm:CodeModificationViewModel">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="#2D2D30" Padding="16">
      <StackPanel>
        <TextBlock Text="Code Modification &amp; Hot Reload" 
                   FontSize="20" FontWeight="Bold" 
                   Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock Text="Modify your Avalonia app using natural language prompts" 
                   FontSize="12" 
                   Foreground="LightGray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- Main Content -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left Panel - Controls -->
      <Border Grid.Column="0" Background="#F3F3F3" BorderBrush="#E1E1E1" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="16">

            <!-- Natural Language Input -->
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="12">
              <StackPanel>
                <TextBlock Text="Natural Language Prompt" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox Text="{Binding NaturalLanguagePrompt}" 
                         Watermark="e.g., Add a new button with blue color and 'Save' text"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
                <Button Content="Process Prompt" Command="{Binding ProcessPromptCommand}" 
                        HorizontalAlignment="Stretch" Margin="0,8,0,0" Background="#0078D4"/>
              </StackPanel>
            </Border>

            <!-- Target Configuration -->
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="12">
              <StackPanel>
                <TextBlock Text="Target Configuration" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Spacing="8">
                  <TextBlock Text="Target Class:" FontWeight="Bold"/>
                  <TextBox Text="{Binding TargetClass}" Watermark="e.g., MainViewModel"/>
                  <TextBlock Text="Target Method:" FontWeight="Bold"/>
                  <TextBox Text="{Binding TargetMethod}" Watermark="e.g., ProcessCommand"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Actions -->
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="12">
              <StackPanel>
                <TextBlock Text="Actions" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Spacing="8">
                  <Button Content="Generate Code" Command="{Binding GenerateCodeCommand}" 
                          HorizontalAlignment="Stretch" Background="#28A745"/>
                  <Button Content="Validate Code" Command="{Binding ValidateCodeCommand}" 
                          HorizontalAlignment="Stretch" Background="#FFC107"/>
                  <Button Content="Apply Hot Reload" Command="{Binding ApplyHotReloadCommand}" 
                          HorizontalAlignment="Stretch" Background="#DC3545"/>
                  <Button Content="Get Current Code" Command="{Binding GetCurrentImplementationCommand}" 
                          HorizontalAlignment="Stretch" Background="#6C757D"/>
                  <Button Content="Suggest Modifications" Command="{Binding SuggestModificationsCommand}" 
                          HorizontalAlignment="Stretch" Background="#17A2B8"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Loaded Components -->
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="12">
              <StackPanel>
                <TextBlock Text="Loaded Components" FontWeight="Bold" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding LoadedComponents}" Height="100"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Right Panel - Code and Results -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Generated Code -->
        <Border Grid.Row="0" Background="White" BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="16,16,16,8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="Generated Code" FontWeight="Bold" Margin="0,0,0,8"/>
            <ScrollViewer Grid.Row="1">
              <TextBox Text="{Binding GeneratedCode}" 
                       IsReadOnly="True" 
                       FontFamily="Consolas" 
                       FontSize="12" 
                       Background="#F8F9FA"
                       AcceptsReturn="True" 
                       TextWrapping="NoWrap"/>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Current Implementation -->
        <Border Grid.Row="1" Background="White" BorderBrush="LightGray" Margin="16,8,16,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="Current Implementation" FontWeight="Bold" Margin="0,0,0,8"/>
            <ScrollViewer Grid.Row="1">
              <TextBox Text="{Binding CurrentImplementation}" 
                       IsReadOnly="True" 
                       FontFamily="Consolas" 
                       FontSize="12" 
                       Background="#F8F9FA"
                       AcceptsReturn="True" 
                       TextWrapping="NoWrap"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Status Bar -->
    <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E1E1E1" BorderThickness="0,1,0,0">
      <Grid Margin="16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Processing:" VerticalAlignment="Center" Opacity="0.7"/>
          <Ellipse Width="12" Height="12" Fill="Green" IsVisible="{Binding IsProcessing}"/>
          <TextBlock Text="Validating:" VerticalAlignment="Center" Opacity="0.7"/>
          <Ellipse Width="12" Height="12" Fill="Yellow" IsVisible="{Binding IsValidating}"/>
          <TextBlock Text="Reloading:" VerticalAlignment="Center" Opacity="0.7"/>
          <Ellipse Width="12" Height="12" Fill="Red" IsVisible="{Binding IsReloading}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
