<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Director.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Director.Avalonia.MainWindow"
        x:DataType="vm:EnhancedMainViewModel"
        Title="Director Studio - Nexo Companion"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        FontFamily="{Binding SystemFontFamily}"
        FontSize="{Binding SystemFontSize}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Top Toolbar -->
    <Border Grid.Row="0" Background="#2D2D30" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Connection Status -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Ellipse Width="12" Height="12" Fill="Green"/>
          <TextBlock Text="{Binding ConnectionStatus}" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Title -->
        <TextBlock Grid.Column="1" Text="Director Studio" 
                   FontSize="18" FontWeight="Bold" 
                   Foreground="White" HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="Connect" Command="{Binding ConnectCommand}" 
                  IsEnabled="{Binding !IsConnected}" Background="#0078D4"/>
          <Button Content="Disconnect" Command="{Binding DisconnectCommand}" 
                  IsEnabled="{Binding IsConnected}" Background="#D13438"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Content -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left Panel - Controls -->
      <Border Grid.Column="0" Background="#F3F3F3" BorderBrush="#E1E1E1" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="16">
            
            <!-- Unity Discovery -->
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Unity Discovery" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Spacing="8">
                  <Button Content="Auto-Discover Unity" Command="{Binding AutoDiscoverUnityCommand}" 
                          HorizontalAlignment="Stretch" Background="#0078D4"/>
                  <TextBlock Text="{Binding UnityStatus}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
                  <ComboBox ItemsSource="{Binding UnityInstallations}" 
                            SelectedItem="{Binding SelectedUnityInstallation}"
                            DisplayMemberBinding="{Binding Version}">
                    <ComboBox.PlaceholderText>Select Unity Installation</ComboBox.PlaceholderText>
                  </ComboBox>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Connection Settings -->
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Connection" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Spacing="8">
                  <TextBlock Text="Token:" FontWeight="Bold"/>
                  <TextBox Text="{Binding Token}" Watermark="Unity token..."/>
                  <Button Content="Auto-Discover Token" Command="{Binding AutoDiscoverTokenCommand}" 
                          HorizontalAlignment="Stretch"/>
                  <Button Content="Auto-Connect" Command="{Binding AutoConnectCommand}" 
                          HorizontalAlignment="Stretch" Background="#28A745"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Nexo Commands -->
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Nexo Commands" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Spacing="8">
                  <Button Content="Run Validation" Command="{Binding RunValidationCommand}" 
                          HorizontalAlignment="Stretch" Background="#28A745"/>
                  <Button Content="Run Analysis" Command="{Binding RunAnalysisCommand}" 
                          HorizontalAlignment="Stretch" Background="#17A2B8"/>
                  <Button Content="List Agents" Command="{Binding ListAgentsCommand}" 
                          HorizontalAlignment="Stretch" Background="#6F42C1"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Unity Commands -->
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Unity Commands" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Spacing="8">
                  <Button Content="Toggle Play Mode" Command="{Binding TogglePlayCommand}" 
                          HorizontalAlignment="Stretch" Background="#FFC107"/>
                  <Button Content="Get Project Info" Command="{Binding GetProjectInfoCommand}" 
                          HorizontalAlignment="Stretch" Background="#FD7E14"/>
                  <Button Content="List Scenes" Command="{Binding ListScenesCommand}" 
                          HorizontalAlignment="Stretch" Background="#20C997"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- UI Modifications -->
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="8">
              <StackPanel>
                <TextBlock Text="UI Modifications" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Spacing="8">
                  <TextBlock Text="Target Slot:" FontWeight="Bold"/>
                  <TextBox Text="{Binding TargetSlot}" Watermark="e.g., quality.filters"/>
                  <Button Content="Apply UI Mod" Command="{Binding ApplyUIModCommand}" 
                          HorizontalAlignment="Stretch" Background="#6F42C1"/>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Right Panel - Logs and Output -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Main Output -->
        <TabControl Grid.Row="0" Margin="16">
          <TabItem Header="Logs">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="LightGray" Margin="0,2" Padding="8,4">
                      <TextBlock Text="{Binding Line}" FontFamily="Consolas" FontSize="12"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
          
          <TabItem Header="Gates">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Gates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="LightBlue" Margin="0,2" Padding="8,4">
                      <StackPanel>
                        <TextBlock Text="{Binding GateName}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Message}" FontSize="11" Opacity="0.8"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#E1E1E1" BorderThickness="0,1,0,0">
          <Grid Margin="16,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding LastActivity}" VerticalAlignment="Center" 
                       FontSize="11" Opacity="0.7"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
