<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Director.Avalonia.ViewModels"
        xmlns:local="using:Director.Avalonia.Views"
        xmlns:converters="using:Director.Avalonia.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="1000"
        x:Class="Director.Avalonia.MainWindow"
        x:DataType="vm:EnhancedMainViewModel"
        Title="Director Studio - Nexo Companion"
        Width="1600" Height="1000"
        MinWidth="1200" MinHeight="800"
        FontFamily="{Binding SystemFontFamily}">

  <Window.Resources>
    <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header Navigation - Larger, More Readable -->
    <Border Grid.Row="0" 
            Background="White" 
            BorderBrush="#E0E0E0" 
            BorderThickness="0,0,0,2" 
            Padding="32,24">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Connection Status - Larger -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <Ellipse Width="16" Height="16" 
                   Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}" 
                   Classes="status-indicator"/>
          <TextBlock Text="{Binding ConnectionStatus}" 
                     Classes="body-large"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Title - Larger -->
        <TextBlock Grid.Column="1" 
                   Text="Director Studio" 
                   Classes="heading-1"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>

        <!-- Action Buttons - Larger -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
          <Button Content="Connect" 
                  Command="{Binding ConnectCommand}" 
                  IsEnabled="{Binding !IsConnected}" 
                  Classes="primary"
                  MinWidth="120"/>
          <Button Content="Disconnect" 
                  Command="{Binding DisconnectCommand}" 
                  IsEnabled="{Binding IsConnected}" 
                  Classes="danger"
                  MinWidth="120"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Content -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left Sidebar - Better Spacing -->
      <Border Grid.Column="0" 
              Background="#F8F9FA" 
              BorderBrush="#E0E0E0" 
              BorderThickness="0,0,2,0">
        <ScrollViewer Padding="32" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="32">
            
            <!-- Unity Discovery Card -->
            <Border Classes="card">
              <StackPanel Spacing="20">
                <TextBlock Text="Unity Discovery" Classes="heading-2"/>
                <StackPanel Spacing="16">
                  <Button Content="Auto-Discover Unity" 
                          Command="{Binding AutoDiscoverUnityCommand}" 
                          HorizontalAlignment="Stretch" 
                          Classes="primary"/>
                  <TextBlock Text="{Binding UnityStatus}" 
                             Classes="caption"
                             TextWrapping="Wrap"/>
                  <ComboBox ItemsSource="{Binding UnityInstallations}" 
                            SelectedItem="{Binding SelectedUnityInstallation}"
                            DisplayMemberBinding="{Binding Version}"
                            Classes="body">
                    <ComboBox.PlaceholderText>Select Unity Installation</ComboBox.PlaceholderText>
                  </ComboBox>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Connection Settings Card -->
            <Border Classes="card">
              <StackPanel Spacing="20">
                <TextBlock Text="Connection Settings" Classes="heading-2"/>
                <StackPanel Spacing="20">
                  <!-- Communication Mode Toggle - Better Layout -->
                  <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding UseFileBasedCommunication}" 
                              Classes="switch"
                              VerticalAlignment="Center"/>
                    <StackPanel>
                      <TextBlock Text="File-Based Communication" Classes="body"/>
                      <TextBlock Text="No ports/firewall required" Classes="caption"/>
                    </StackPanel>
                  </StackPanel>
                  
                  <StackPanel Spacing="12">
                    <TextBlock Text="Authentication Token" Classes="body"/>
                    <TextBox Text="{Binding Token}" 
                             Watermark="Unity token..." 
                             Classes="body"/>
                    <Button Content="Auto-Discover Token" 
                            Command="{Binding AutoDiscoverTokenCommand}" 
                            HorizontalAlignment="Stretch"
                            Classes="secondary"/>
                    <Button Content="Auto-Connect" 
                            Command="{Binding AutoConnectCommand}" 
                            HorizontalAlignment="Stretch" 
                            Classes="success"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Nexo Commands Card -->
            <Border Classes="card">
              <StackPanel Spacing="20">
                <TextBlock Text="Nexo Commands" Classes="heading-2"/>
                <StackPanel Spacing="12">
                  <Button Content="Run Validation" 
                          Command="{Binding RunValidationCommand}" 
                          HorizontalAlignment="Stretch" 
                          Classes="success"/>
                  <Button Content="Run Analysis" 
                          Command="{Binding RunAnalysisCommand}" 
                          HorizontalAlignment="Stretch" 
                          Classes="info"/>
                  <Button Content="List Agents" 
                          Command="{Binding ListAgentsCommand}" 
                          HorizontalAlignment="Stretch" 
                          Classes="secondary"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Unity Commands Card -->
            <Border Classes="card">
              <StackPanel Spacing="20">
                <TextBlock Text="Unity Commands" Classes="heading-2"/>
                <StackPanel Spacing="12">
                  <Button Content="Toggle Play Mode" 
                          Command="{Binding TogglePlayCommand}" 
                          HorizontalAlignment="Stretch" 
                          Classes="warning"/>
                  <Button Content="Get Project Info" 
                          Command="{Binding GetProjectInfoCommand}" 
                          HorizontalAlignment="Stretch" 
                          Classes="info"/>
                  <Button Content="List Scenes" 
                          Command="{Binding ListScenesCommand}" 
                          HorizontalAlignment="Stretch" 
                          Classes="secondary"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- UI Modifications Card -->
            <Border Classes="card">
              <StackPanel Spacing="20">
                <TextBlock Text="UI Modifications" Classes="heading-2"/>
                <StackPanel Spacing="16">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Target Slot" Classes="body"/>
                    <TextBox Text="{Binding TargetSlot}" 
                             Watermark="e.g., quality.filters" 
                             Classes="body"/>
                    <Button Content="Apply UI Modification" 
                            Command="{Binding ApplyUIModCommand}" 
                            HorizontalAlignment="Stretch" 
                            Classes="secondary"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Right Content Area -->
      <Grid Grid.Column="1" Background="#F8F9FA">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Output Tabs - Better Spacing -->
        <TabControl Grid.Row="0" Margin="32" Classes="body">
          <TabItem Header="Logs">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20">
              <ItemsControl ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="log-item">
                      <TextBlock Text="{Binding Line}" 
                                 Classes="mono"
                                 TextWrapping="Wrap"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
          
          <TabItem Header="Gates">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20">
              <ItemsControl ItemsSource="{Binding Gates}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="gate-item">
                      <StackPanel Spacing="12">
                        <TextBlock Text="{Binding GateName}" 
                                   Classes="body"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Message}" 
                                   Classes="body-small"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Code Modification">
            <local:CodeModificationView/>
          </TabItem>
        </TabControl>

        <!-- Status Bar - Better Spacing -->
        <Border Grid.Row="1" Classes="status-bar">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" 
                       Text="{Binding StatusMessage}" 
                       VerticalAlignment="Center"
                       Classes="body-small"/>
            <TextBlock Grid.Column="1" 
                       Text="{Binding LastActivity}" 
                       VerticalAlignment="Center" 
                       Classes="caption"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>