<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageId>Director.UI.Primitives</PackageId>
    <Version>1.0.0</Version>
    <Authors>Director Studio</Authors>
    <Description>Framework-agnostic UI primitives and design tokens for Director Studio</Description>
    <PackageTags>ui;design-system;primitives;design-tokens</PackageTags>
    <RepositoryUrl>https://github.com/nexo-ai/director</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

</Project>
