<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Nexo.Spatial.Platform.VisionPro</PackageId>
    <Title>Nexo Spatial Vision Pro Platform</Title>
    <Description>visionOS WorldTracking ISpatialAnchorProvider (P2-S3). Headless hosts fail closed until immersive-space session wiring lands.</Description>
    <PackageTags>nexo;spatial;visionpro;visionos;platform</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexo.Spatial.Contracts\Nexo.Spatial.Contracts.csproj" />
  </ItemGroup>

</Project>
