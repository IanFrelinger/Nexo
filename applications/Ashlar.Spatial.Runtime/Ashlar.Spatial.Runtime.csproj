<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Ashlar.Spatial.Runtime</PackageId>
    <Title>Ashlar Spatial Runtime</Title>
    <Description>Certified atom pose binding — the identity/pose seam.</Description>
    <PackageTags>ashlar;spatial;pose;runtime</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashlar.Certification.Physical\Ashlar.Certification.Physical.csproj" />
    <ProjectReference Include="..\Ashlar.Spatial.Contracts\Ashlar.Spatial.Contracts.csproj" />
    <ProjectReference Include="..\Ashlar.Spatial.Multiplayer\Ashlar.Spatial.Multiplayer.csproj" />
    <ProjectReference Include="..\Ashlar.Spatial.Platform.ARKit\Ashlar.Spatial.Platform.ARKit.csproj" />
    <ProjectReference Include="..\Ashlar.Spatial.Platform.VisionPro\Ashlar.Spatial.Platform.VisionPro.csproj" />
    <ProjectReference Include="..\Ashlar.Spatial.Platform.XREAL\Ashlar.Spatial.Platform.XREAL.csproj" />
  </ItemGroup>

</Project>
