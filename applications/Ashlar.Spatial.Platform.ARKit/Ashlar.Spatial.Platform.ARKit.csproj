<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Ashlar.Spatial.Platform.ARKit</PackageId>
    <Title>Ashlar Spatial ARKit Platform</Title>
    <Description>ARKit-backed ISpatialAnchorProvider (P2). Headless hosts fail closed until native ARKit session wiring lands.</Description>
    <PackageTags>ashlar;spatial;arkit;platform</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashlar.Spatial.Contracts\Ashlar.Spatial.Contracts.csproj" />
  </ItemGroup>

</Project>
