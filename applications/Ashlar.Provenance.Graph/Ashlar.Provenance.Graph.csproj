<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Ashlar.Provenance.Graph</PackageId>
    <Title>Ashlar Provenance Graph</Title>
    <Description>Neo4j-backed read-only certification provenance graph projection for lineage queries.</Description>
    <PackageTags>ashlar;provenance;neo4j;certification;lineage</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Neo4j.Driver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashlar.Certification.Physical\Ashlar.Certification.Physical.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Neo4j\Neo4jSchemaMigration.cypher" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
