# Git
.git
.gitignore

# Test results
test-results/
*.trx
*.coverage

# Build artifacts
bin/
obj/
**/bin/
**/obj/
artifacts/

# IDE
.vs/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation
*.md
!README.md

# CI/CD (not needed in container)
.github/

# Docker files themselves (compose files live under deploy/compose/, not the repo root)
.docker/
# ...except payloads a Dockerfile COPYs. The Dockerfile itself reaches the daemon via -f, outside
# the context, so excluding .docker/ costs nothing — but a file COPYd from it must be IN the
# context or the build fails with "not found" pointing at the COPY line rather than at this rule.
!.docker/node-agents.json
!.docker/node-entrypoint.sh
deploy/compose/
Dockerfile*
