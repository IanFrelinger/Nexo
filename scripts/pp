#!/usr/bin/env bash
# Public entrypoint for the parser pipeline. No exports required for common layouts.
#
#   ./scripts/pp              # quick up (scaffold agent; SKIP_OLLAMA=1 by default)
#   ./scripts/pp down
#   ./scripts/pp status
#   ./scripts/pp quick        # same as default
#   ./scripts/pp full         # up with Ollama
#   ./scripts/pp e2e          # up + mock end-to-end test
#
# Windows: pwsh -File scripts/Install-ParserPipeline.ps1
#
# Auto-detects Nexo/Poco/WORKSPACE_ROOT ($HOME/work). Maintainer helpers live in scripts/dev/.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if grep -q $'\r' "$0" 2>/dev/null; then
  tmp="$(mktemp)"; tr -d '\r' < "$0" > "$tmp"; chmod +x "$tmp"; exec bash "$tmp" "$@"
fi

CMD="${1:-quick}"
shift || true

case "$CMD" in
  up|quick)
    export SKIP_OLLAMA="${SKIP_OLLAMA:-1}"
    export WITH_EXTRACT_AGENT="${WITH_EXTRACT_AGENT:-1}"
    ACTION=up
    ;;
  full)
    export SKIP_OLLAMA=0
    export SKIP_MODEL_PULL="${SKIP_MODEL_PULL:-0}"
    export WITH_EXTRACT_AGENT=1
    ACTION=up
    ;;
  e2e)
    export SKIP_OLLAMA="${SKIP_OLLAMA:-1}"
    export WITH_EXTRACT_AGENT=1
    export E2E=1
    ACTION=up
    ;;
  down|status)
    ACTION="$CMD"
    ;;
  help|-h|--help)
    sed -n '2,12p' "$0" | sed 's/^# \?//'
    exit 0
    ;;
  *)
    echo "usage: $0 [quick|full|e2e|up|down|status]" >&2
    exit 1
    ;;
esac

export NEXO_ROOT="${NEXO_ROOT:-$ROOT}"
export WORKSPACE_ROOT="${WORKSPACE_ROOT:-$HOME/work}"
# docker compose uses COMPOSE_PROJECT_NAME; setup-parser-pipeline.sh uses COMPOSE_PROJECT.
if [ -z "${COMPOSE_PROJECT:-}" ] && [ -n "${COMPOSE_PROJECT_NAME:-}" ]; then
  export COMPOSE_PROJECT="$COMPOSE_PROJECT_NAME"
fi
mkdir -p "$WORKSPACE_ROOT"

if [ -z "${POCO_CONTEXT:-}" ]; then
  for c in \
    "$ROOT/../poco" \
    "$ROOT/../Poco" \
    "$WORKSPACE_ROOT/poco" \
    "$ROOT/../../poco" \
    "$ROOT/poco"
  do
    if [ -f "$c/Dockerfile" ]; then
      export POCO_CONTEXT="$(cd "$c" && pwd)"
      break
    fi
  done
fi

# Transfer-bundle layout: docker-transfer/{nexo,poco}
if [ -z "${POCO_CONTEXT:-}" ] && [ -f "$ROOT/../poco/Dockerfile" ]; then
  export POCO_CONTEXT="$(cd "$ROOT/../poco" && pwd)"
fi

[ -n "${POCO_CONTEXT:-}" ] || {
  echo "error: Poco not found next to Nexo. Clone/copy it as ../poco or set POCO_CONTEXT." >&2
  exit 1
}

export AUTO_PORTS="${AUTO_PORTS:-1}"
export SKIP_IF_HEALTHY="${SKIP_IF_HEALTHY:-1}"
export SEED="${SEED:-1}"
export VERIFY="${VERIFY:-1}"

echo "pp: NEXO_ROOT=$NEXO_ROOT"
echo "pp: POCO_CONTEXT=$POCO_CONTEXT"
echo "pp: WORKSPACE_ROOT=$WORKSPACE_ROOT"
echo "pp: action=$ACTION skip_ollama=${SKIP_OLLAMA:-?} e2e=${E2E:-0}"

exec bash "$ROOT/scripts/setup-parser-pipeline.sh" "$ACTION" "$@"
