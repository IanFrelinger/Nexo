{
  "DomainLogicComponents": [
    {
      "Name": "MovementLogic",
      "Description": "Abstract movement logic that can work across platforms",
      "Domain": "Movement",
      "Interfaces": [
        "IMovementProvider",
        "IMovementValidator"
      ],
      "Dependencies": [
        "IInputProvider",
        "IPhysicsProvider"
      ],
      "CrossDomainUsages": [
        "Unity",
        "Unreal",
        "WebGL",
        "Mobile"
      ]
    },
    {
      "Name": "CombatLogic",
      "Description": "Abstract combat system with weapon management",
      "Domain": "Combat",
      "Interfaces": [
        "IWeaponProvider",
        "IDamageCalculator",
        "ICombatValidator"
      ],
      "Dependencies": [
        "IHealthProvider",
        "IAudioProvider",
        "IAnimationProvider"
      ],
      "CrossDomainUsages": [
        "Unity",
        "Unreal",
        "WebGL",
        "Mobile",
        "Console"
      ]
    },
    {
      "Name": "HealthLogic",
      "Description": "Abstract health and damage system",
      "Domain": "Health",
      "Interfaces": [
        "IHealthProvider",
        "IDamageProvider",
        "IHealthValidator"
      ],
      "Dependencies": [
        "IEventProvider",
        "IStateProvider"
      ],
      "CrossDomainUsages": [
        "Unity",
        "Unreal",
        "WebGL",
        "Mobile",
        "Console",
        "Desktop"
      ]
    },
    {
      "Name": "AILogic",
      "Description": "Abstract AI behavior system",
      "Domain": "AI",
      "Interfaces": [
        "IBehaviorProvider",
        "IPathfindingProvider",
        "IDecisionProvider"
      ],
      "Dependencies": [
        "IWorldProvider",
        "IStateProvider",
        "IEventProvider"
      ],
      "CrossDomainUsages": [
        "Unity",
        "Unreal",
        "WebGL",
        "Mobile",
        "Console"
      ]
    },
    {
      "Name": "AudioLogic",
      "Description": "Abstract audio management system",
      "Domain": "Audio",
      "Interfaces": [
        "IAudioProvider",
        "ISoundValidator",
        "IMusicProvider"
      ],
      "Dependencies": [
        "IResourceProvider",
        "ISpatialProvider"
      ],
      "CrossDomainUsages": [
        "Unity",
        "Unreal",
        "WebGL",
        "Mobile",
        "Console",
        "Desktop"
      ]
    }
  ],
  "PlatformImplementations": [
    {
      "Platform": "Unity",
      "TargetFramework": "Unity 2022.3 LTS",
      "ImplementationStyle": "MonoBehaviour-based",
      "Dependencies": [
        "UnityEngine",
        "Unity.InputSystem",
        "Unity.AI.Navigation"
      ]
    },
    {
      "Platform": "Unreal",
      "TargetFramework": "Unreal Engine 5",
      "ImplementationStyle": "Actor-based",
      "Dependencies": [
        "Core",
        "Engine",
        "AIModule",
        "AudioMixer"
      ]
    },
    {
      "Platform": "WebGL",
      "TargetFramework": "WebAssembly",
      "ImplementationStyle": "Component-based",
      "Dependencies": [
        "System",
        "System.Threading.Tasks"
      ]
    }
  ],
  "CompositionComponents": [
    {
      "Name": "GameOrchestrator",
      "Description": "Orchestrates all domain logic components",
      "Responsibilities": [
        "Component Registration",
        "Dependency Injection",
        "Lifecycle Management"
      ]
    },
    {
      "Name": "PlatformAdapter",
      "Description": "Adapts domain logic to specific platforms",
      "Responsibilities": [
        "Platform Detection",
        "Implementation Selection",
        "Interface Mapping"
      ]
    }
  ]
}