# Nexo.API operator exposure (does not configure firewalls / Tailscale ACLs / reverse proxies — do that separately).
# Merge into your environment or pass: docker compose --env-file ...
#
# ExposureProfile: Localhost | Lan | Tailnet | Public (case-insensitive)
# FAIL-CLOSED: Lan / Tailnet / Public refuse to START while AuthorizationMode=None (and the legacy flag is off).
# Configure one of the auth blocks below, or set the escape hatch ONLY when an authenticating proxy /
# network ACL fronts Nexo.API:
# Nexo__Security__AllowUnauthenticatedNetworkExposure=true
Nexo__Security__ExposureProfile=Tailnet

# Optional built-in API key auth for mutating endpoints:
# - enforced on POST/PUT/PATCH/DELETE under /api/*
# - advisory/status/capabilities GET routes remain open
# - set true to enforce and provide key via X-Nexo-Api-Key header
# - fails closed: true with no ApiKey rejects every mutating request (401)
# Nexo__Security__RequireApiKeyForMutatingEndpoints=true
# Nexo__Security__ApiKey=replace-with-strong-secret
# Nexo__Security__ApiKeyHeaderName=X-Nexo-Api-Key
# Nexo__Security__ExcludedApiKeyPaths=/api/director/run,/api/orchestrate

# Optional generalized built-in authorization layers:
# - AuthorizationMode: None | ApiKey | BearerToken | Basic | ApiKeyOrBearerToken | ApiKeyOrBasic | BearerTokenOrBasic | Any
# - AuthorizationScope: MutatingApi | AllApi
# - If AuthorizationMode != None, it takes precedence over RequireApiKeyForMutatingEndpoints
# Nexo__Security__AuthorizationMode=ApiKeyOrBearerToken
# Nexo__Security__AuthorizationScope=MutatingApi
# Nexo__Security__ExcludedAuthorizationPaths=/api/security/advisory,/api/status
#
# API key mode uses:
# Nexo__Security__ApiKey=replace-with-strong-secret
# Nexo__Security__ApiKeyHeaderName=X-Nexo-Api-Key
#
# Bearer token mode uses:
# Nexo__Security__BearerToken=replace-with-strong-token
# Nexo__Security__BearerTokenHeaderName=Authorization
# Nexo__Security__BearerTokenScheme=Bearer
#
# Basic auth mode uses:
# Nexo__Security__BasicAuthUsername=nexo
# Nexo__Security__BasicAuthPassword=replace-with-strong-password
# Nexo__Security__BasicAuthHeaderName=Authorization

# Optional extra line in the Director portal advisory banner
# Nexo__Security__CustomAdvisory=Use tag:nexo; no shared accounts.

# Set false to hide the portal banner (GET /api/security/advisory still works)
# Nexo__Security__ShowAdvisoryInPortal=true

# Remote container execution surface (POST /api/execution/build|run for RemoteExecutionPlatform):
# dark by default; requires an AuthorizationMode above (403 otherwise). VolumeMounts are rejected
# unless AllowedVolumeMountRoot names the single host directory they may live under.
# Nexo__Execution__ServeRemoteExecution=true
# Nexo__Execution__AllowedVolumeMountRoot=/srv/nexo/test-results
