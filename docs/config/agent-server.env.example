# Copy to `deploy/compose/.env` (Compose v2 loads `.env` from the directory of the first `-f` compose
# file, NOT from the shell CWD / repo root) or pass any path explicitly with:
#   docker compose --env-file path/to/this/file -f deploy/compose/docker-compose.agent-server.yml up -d --build
#
# All variables are optional unless you need to override defaults shown below.

# --- Isolate named volumes & networks per machine or parallel stacks ---
# COMPOSE_PROJECT_NAME=nexo-agent-dev

# --- Host bind-mount: repository the agents operate on (host path) ---
# Windows (PowerShell): use forward slashes or escaped backslashes, e.g.
#   NEXO_REPO_ROOT=C:/Users/you/source/Nexo
# macOS / Linux:
#   NEXO_REPO_ROOT=/home/you/source/Nexo
# Default when unset: the repo root (`../..` relative to deploy/compose/, where the compose file lives;
# relative host paths resolve against the compose file directory, not the shell CWD).
# NEXO_REPO_ROOT=../..

# --- Path inside the container (must match working_dir and agent config paths) ---
# NEXO_CONTAINER_WORKDIR=/work

# --- Extra Docker volume suffix (Linux SELinux: :z or :Z; read-only tree: :ro) ---
# Examples:
#   NEXO_REPO_MOUNT_SUFFIX=:z
#   NEXO_REPO_MOUNT_SUFFIX=:ro
# NEXO_REPO_MOUNT_SUFFIX=

# --- HTTP ports (host:container; container side fixed at 8080 / 11434) ---
# NEXO_API_HOST=127.0.0.1
# NEXO_AGENT_SERVER_HTTP_PORT=8080
# NEXO_OLLAMA_HOST_PORT=11434
#
# Full-stack Windows lane (Start-FullstackAgentServer.ps1) often uses:
#   NEXO_AGENT_SERVER_HTTP_PORT=8088
# so host :8080 can stay free for other services.
#
# Override at start time:
#   .\scripts\Start-FullstackAgentServer.ps1 -ApiPort 8090 -OllamaHostPort 11434

# --- Ollama (bundled container) ---
# NEXO_OLLAMA_IMAGE=ollama/ollama:latest
# OLLAMA_MODEL=llama3.1:latest

# --- Point API at Ollama (override for external / host-run Ollama) ---
# Bundled stack uses service DNS name:
#   OLLAMA_BASE_URL=http://ollama:11434
# Docker Desktop (Mac / Windows) — Ollama on the host (port must match NEXO_OLLAMA_HOST_PORT):
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# Linux — Ollama on host (typical bridge gateway; adjust if needed):
#   OLLAMA_BASE_URL=http://172.17.0.1:11434

# --- Background agent JSON (path *inside* container) ---
# NEXO_BACKGROUND_AGENTS_CONFIG=/work/apps/runtime-studio/config/agent_set.local.json

# --- Director dailies (path inside container; default matches compose volume mount /data/dailies) ---
# If you change this, add a matching bind-mount or override compose (named volume stays on /data/dailies by default).
# NEXO_DAILIES_PATH=/data/dailies

# --- Runtime state: LiteDB stores + snapshots (path inside container; default matches compose volume mount /data/state) ---
# Keeps nexo-*.db out of the mounted repo under /work. If you change this, add a matching volume in an override file.
# NEXO_STATE_DIR=/data/state

# --- Build (context default is the repo root, ../.. relative to deploy/compose/) ---
# NEXO_BUILD_CONTEXT=../..
# NEXO_AGENT_SERVER_DOCKERFILE=.docker/Dockerfile.agent-server

# --- Trust / observation (hosted defaults; tighten for production) ---
# Nexo__Barriers__RequireExplicitBarrier=false
# NEXO_OBSERVATION_DEGRADED_MODE=1
