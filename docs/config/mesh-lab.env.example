# Copy to repo root as `.env.mesh-lab` (gitignored) for the virtual mesh lab:
#   docker compose -f docker-compose.mesh-lab.yml --env-file .env.mesh-lab up -d --build
#
# Both peers use the same API key below (lab convenience).

Nexo__Security__ApiKey=CHANGE_ME_LAB_API_KEY
Nexo__Security__AuthorizationMode=ApiKey
Nexo__Security__AuthorizationScope=MutatingApi
Nexo__Security__ExposureProfile=Lan

# Optional: override host publish (default 127.0.0.1:18081 and :18082)
# MESH_LAB_PEER_A_PUBLISH=127.0.0.1:18081
# MESH_LAB_PEER_B_PUBLISH=127.0.0.1:18082
