# Copy to `.env.mesh-lab` (gitignored). Used by docker-compose.mesh-lab.yml.
#
# Image mix (defaults in compose — override per role):
#   MESH_LAB_PEER_A_DOCKERFILE   default .docker/Dockerfile.api
#   MESH_LAB_PEER_B_DOCKERFILE   default .docker/Dockerfile.quickstart
#   MESH_LAB_WORKER_DOCKERFILE   default .docker/Dockerfile.api (set to .docker/Dockerfile.agent-server for SDK image)
#
# peer-b defaults to ApiKeyOrBearerToken so CI/scripts can use either header.

# Shared API key (peer-a + peer-b + worker accept it where ApiKey is configured)
Nexo__Security__ApiKey=CHANGE_ME_LAB_API_KEY

# Per-peer registration secret for director fleet POST (must differ from ApiKey; peer-a enforces by default)
MESH_LAB_PEER_REGISTRATION_KEY=CHANGE_ME_LAB_PEER_REGISTRATION_KEY
# Optional: mesh-lab-verify-governance.sh rotation check (defaults to ${MESH_LAB_PEER_REGISTRATION_KEY}-rotated-v2)
# MESH_LAB_PEER_REGISTRATION_KEY_ROTATED=CHANGE_ME_LAB_PEER_REGISTRATION_KEY_V2

# Copilot-scoped key (worker tier): mesh POST forbidden; copilot routes allowed
Nexo__Security__CopilotScopedApiKey=CHANGE_ME_LAB_COPILOT_SCOPED_KEY

# Hourly copilot submissions per tenant on worker (0 = unlimited)
Nexo__Entitlements__MaxCopilotSubmissionsPerHour=2

# Bearer path for peer-b (same value is fine for a lab)
Nexo__Security__PeerB__BearerToken=CHANGE_ME_LAB_BEARER_OR_SAME_AS_API_KEY

# Basic auth for worker tier (ApiKeyOrBasic / ApiKeyOrBearerToken modes)
Nexo__Security__Worker__BasicAuthUsername=nexo
Nexo__Security__Worker__BasicAuthPassword=CHANGE_ME_LAB_BASIC_PASSWORD

# Optional: per-role overrides (examples)
# MESH_LAB_PEER_A_EXPOSURE=Lan
# MESH_LAB_PEER_B_EXPOSURE=Tailnet
# MESH_LAB_WORKER_EXPOSURE=Public
# MESH_LAB_PEER_A_AUTH_MODE=ApiKey
# MESH_LAB_PEER_B_AUTH_MODE=ApiKeyOrBearerToken
# MESH_LAB_WORKER_AUTH_MODE=ApiKeyOrBasic
# MESH_LAB_PEER_A_ASPNETCORE_ENVIRONMENT=Production
# MESH_LAB_PEER_B_ASPNETCORE_ENVIRONMENT=Staging
# MESH_LAB_WORKER_ASPNETCORE_ENVIRONMENT=Development

# Optional host publish (peer ports)
# MESH_LAB_PEER_A_PUBLISH=127.0.0.1:18081
# MESH_LAB_PEER_B_PUBLISH=127.0.0.1:18082

# Optional host publish for worker tier (default in compose: 127.0.0.1:18083)
# MESH_LAB_WORKER_PUBLISH=127.0.0.1:18083

# Optional brick id for mesh-lab-verify.sh execute probe (default: first catalog entry on peer-b)
# MESH_LAB_VERIFY_BRICK_ID=observation-context

# Worker container: autonomous mesh task executor (polls peer-a director)
# MESH_LAB_WORKER_EXECUTOR_ENABLED=true
# MESH_LAB_WORKER_EXECUTOR_DIRECTOR_URL=http://peer-a:8080
# MESH_LAB_SKIP_WORKER_EXECUTOR=1   # host verify only: skip autonomous worker check
# MESH_LAB_SKIP_DIRECTOR_CLI_VERIFY=1   # skip commercial mesh director CLI checks (no SDK on host)
# MESH_LAB_SKIP_PERSISTENCE_VERIFY=1   # skip peer-a restart / LiteDB persistence check
# MESH_LAB_SKIP_POST_STRESS_VERIFY=1   # skip post-stress checks when MESH_LAB_RUN_STRESS=1
# MESH_LAB_SKIP_NETWORK_NEGATIVE_VERIFY=1   # skip unreachable peer / peer-b stop / director restart checks

# Director persistence (peer-a only; compose default LiteDb + volume)
# Nexo__Mesh__Persistence__Provider=LiteDb
# Nexo__Mesh__Persistence__DatabasePath=/data/mesh-director.db

# Workers profile: scripts/mesh-lab-stress-ramp.sh
