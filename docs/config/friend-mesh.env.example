# Copy to repo root as `.env.friend-mesh` (gitignored) and pass to Compose:
#   docker compose -f deploy/compose/docker-compose.friend-mesh.yml --env-file .env.friend-mesh up -d --build
#
# Replace every CHANGE_ME value. Share the API key and mesh tokens only via a private channel.

# --- Optional: override image build (context default is the repo root, ../.. relative to deploy/compose/) ---
# ASHLAR_BUILD_CONTEXT=../..
# ASHLAR_FRIEND_MESH_DOCKERFILE=.docker/Dockerfile.api

# --- Host publish (default: loopback only) ---
# Loopback (safest default — use SSH tunnel or reverse proxy):
ASHLAR_FRIEND_MESH_PORT_PUBLISH=127.0.0.1:8080
# LAN example (only on trusted networks):
# ASHLAR_FRIEND_MESH_PORT_PUBLISH=0.0.0.0:8080

# --- Ashlar.API security (required for friend mesh) ---
Ashlar__Security__ExposureProfile=Tailnet
Ashlar__Security__AuthorizationMode=ApiKey
Ashlar__Security__AuthorizationScope=MutatingApi
Ashlar__Security__ApiKey=CHANGE_ME_LONG_RANDOM_API_KEY
Ashlar__Security__ApiKeyHeaderName=X-Ashlar-Api-Key
Ashlar__Security__CustomAdvisory=Friend mesh — TLS or Tailscale in front; rotate keys if leaked.

# When your Ashlar build includes mesh HTTP hardening (Ashlar:Security:Mesh), set these so peers can call /api/mesh:
# Ashlar__Security__Mesh__MeshMutatingToken=CHANGE_ME_MESH_MUTATING
# Ashlar__Security__Mesh__BrickExecuteToken=CHANGE_ME_BRICK_EXECUTE

# --- instances.json (CLI mesh discovery) ---
# Optional per-peer fields (see docs/MeshPhase8OperatorHardening.md):
#   "admitted": false  — excluded from discovery when ASHLAR_MESH_TRUST_POLICY=allowlist
#   "drained": true    — always excluded from discovery
