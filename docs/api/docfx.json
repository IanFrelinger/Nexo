{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Ashlar.Hosting/Ashlar.Hosting.csproj",
            "Ashlar.Core.Application/Ashlar.Core.Application.csproj",
            "Ashlar.Abstractions/Ashlar.Abstractions.csproj",
            "Ashlar.Core.Domain/Ashlar.Core.Domain.csproj",
            "Ashlar.Infrastructure/Ashlar.Infrastructure.csproj"
          ],
          "src": "../../src"
        }
      ],
      "output": "api",
      "properties": {
        "TargetFramework": "net8.0",
        "Configuration": "Release"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/*.yml", "index.md", "versioning.md"]
      },
      {
        "files": ["GettingStarted.md", "Architecture.md", "Configuration.md", "Persistence.md"],
        "src": ".."
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appTitle": "Ashlar API Reference",
      "_appName": "Ashlar"
    }
  }
}
