@page "/"
@rendermode InteractiveServer
@inject INexoClient Nexo

<h1>Nexo client (Blazor)</h1>
<p>Calls <code>GET api/status</code> via <code>INexoClient</code>.</p>
<button type="button" @onclick="LoadAsync">Get API status</button>
<pre style="margin-top: 1rem; white-space: pre-wrap;">@_output</pre>

@code {
    private string _output = "(click the button; Nexo.API must be running)";

    private async Task LoadAsync()
    {
        try
        {
            var status = await Nexo.GetStatusAsync().ConfigureAwait(false);
            _output = System.Text.Json.JsonSerializer.Serialize(status,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (Exception ex)
        {
            _output = ex.ToString();
        }
    }
}
