<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ashlar.Demos.Avalonia.MainWindow"
        Title="Ashlar Avalonia demo"
        Width="620"
        Height="380">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Base URL (Ashlar.API)" />
        <TextBox Name="BaseUrlBox"
                 Text="http://localhost:5000"
                 Watermark="http://localhost:5000" />
        <Button Name="StatusButton"
                Content="Get API status"
                HorizontalAlignment="Left"
                Click="OnStatusClick" />
        <TextBox Name="OutputBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="200"
                 IsReadOnly="True" />
    </StackPanel>
</Window>
