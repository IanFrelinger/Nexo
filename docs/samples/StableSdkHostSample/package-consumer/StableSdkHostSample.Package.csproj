<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Standalone sample: do not inherit repo central package management (Ashlar.Hosting version is local feed). -->
    <!-- ManagePackageVersionsCentrally: see Directory.Packages.props in this folder -->
    <!-- Transitive advisories: pinned in package-consumer/Directory.Build.props -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StableSdkHostSamplePackage</AssemblyName>
    <RootNamespace>StableSdkHostSample</RootNamespace>
    <AshlarSdkPackageVersion Condition="'$(AshlarSdkPackageVersion)' == ''">1.0.0</AshlarSdkPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Program.cs" Link="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ashlar.Hosting.Bundle" Version="$(AshlarSdkPackageVersion)" />
  </ItemGroup>
</Project>
