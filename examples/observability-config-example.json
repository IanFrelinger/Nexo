{
  "Observability": {
    "ServiceName": "Nexo",
    "ServiceVersion": "1.0.0",
    "Sampling": {
      "Type": "TraceIdRatioBased",
      "Ratio": 0.1
    },
    "Console": {
      "Enabled": true,
      "IncludeScopes": true,
      "IncludeActivityTags": true
    },
    "Otlp": {
      "Enabled": false,
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc",
      "Headers": {
        "Authorization": "Bearer your-token-here",
        "X-Custom-Header": "custom-value"
      }
    }
  }
}
