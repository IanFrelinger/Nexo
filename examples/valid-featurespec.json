{
  "name": "Data Processing Pipeline",
  "version": "2.1.0",
  "capabilities": [
    "data-ingestion",
    "data-transformation",
    "data-validation",
    "data-export"
  ],
  "parameters": {
    "batch-size": "1000",
    "processing-timeout-seconds": "300",
    "enable-parallel-processing": "true",
    "max-retry-attempts": "3"
  },
  "policies": [
    "data-quality-policy",
    "performance-policy",
    "error-handling-policy"
  ]
}
