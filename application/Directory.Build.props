<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Chain to the repo-root Directory.Build.props; MSBuild only auto-imports the nearest one. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <AshlarIncludeDomainBrickGlobalUsing Condition="
      '$(MSBuildProjectName)' == 'Ashlar.CLI' OR
      '$(MSBuildProjectName)' == 'Ashlar.API'
      ">true</AshlarIncludeDomainBrickGlobalUsing>
  </PropertyGroup>

  <ItemGroup Condition="'$(AshlarIncludeDomainBrickGlobalUsing)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)../src/Ashlar.Compat/GlobalUsings.DomainBrick.cs" Link="GlobalUsings.DomainBrick.cs" />
  </ItemGroup>
</Project>
