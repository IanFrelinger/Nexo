<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Nexo.API</PackageId>
    <Title>Nexo API</Title>
    <Description>HTTP API for Nexo kernel. Exposes agent, validate, improve, observe, and execution endpoints.</Description>
    <PackageTags>nexo;ai;api;orchestration</PackageTags>
    <RepositoryUrl>https://github.com/IanFrelinger/Nexo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexo.Tests.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- OTLP export (traces + metrics), active only when OTEL_EXPORTER_OTLP_ENDPOINT is set. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <ProjectReference Include="../../../src/Nexo.BackgroundAgents.HostRunners/Nexo.BackgroundAgents.HostRunners.csproj" />
    <ProjectReference Include="../../../src/Nexo.Brick.Contracts/Nexo.Brick.Contracts.csproj" />
    <ProjectReference Include="../../../src/Nexo.Contracts/Nexo.Contracts.csproj" />
    <ProjectReference Include="../../../src/Nexo.Hosting/Nexo.Hosting.csproj" />
    <ProjectReference Include="../../../src/Nexo.Ingress.DynamoDb/Nexo.Ingress.DynamoDb.csproj" />
    <ProjectReference Include="../../../src/Nexo.Ingress.AwsSns/Nexo.Ingress.AwsSns.csproj" />
    <ProjectReference Include="../../../src/Nexo.Infrastructure/Nexo.Infrastructure.csproj" />
    <!-- Agent-protocol adapters (feature-flagged off by default). Note: the A2A projects are
         IsPackable=false while the A2A SDK is prerelease; Nexo.API is not packed by any release
         workflow today, but if it ever is, these references must be revisited (NU5104). -->
    <ProjectReference Include="../../../src/Nexo.Mcp.Server/Nexo.Mcp.Server.csproj" />
    <ProjectReference Include="../../../src/Nexo.Mcp.Client/Nexo.Mcp.Client.csproj" />
    <ProjectReference Include="../../../src/Nexo.Transport.A2A/Nexo.Transport.A2A.csproj" />
    <ProjectReference Include="../../../src/Nexo.Transport.A2A.Server/Nexo.Transport.A2A.Server.csproj" />
  </ItemGroup>

</Project>
