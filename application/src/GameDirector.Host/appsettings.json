{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Nexo": {
    "PatternStorePath": "nexo-patterns.db",
    "RegisterBackgroundAgentHostedService": false,
    "Security": {
      "AuthorizationMode": "ApiKey",
      "AuthorizationScope": "MutatingApi",
      "ApiKey": "game-director-dev-key"
    },
    "Trust": {
      "ActivePackId": "internal-only"
    }
  },
  "GameDirector": {
    "BalanceWatchPath": "data/balance",
    "MapWatchPath": "data/maps",
    "DriftThresholdPercent": 15,
    "BalanceWatcherInterval": "00:15:00",
    "MapValidatorFullScanInterval": "01:00:00",
    "TrustPackId": "internal-only"
  }
}
