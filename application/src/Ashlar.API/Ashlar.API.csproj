<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Ships on net10.0 (Dockerfiles publish -f net10.0). net8.0 is kept because Ashlar.API is
         also consumed as a library: the net8.0 inner build of Ashlar.Tests.Infrastructure (Tests/API)
         and the commercial hosts (GameDirector.Host, Fleet.Api, Fleet.Host) reference this project.
         Multi-target means `dotnet run` on this project needs `-f net10.0` (see CONTRIBUTING.md). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Ashlar.API</PackageId>
    <Title>Ashlar API</Title>
    <Description>HTTP API for Ashlar kernel. Exposes agent, validate, improve, observe, and execution endpoints.</Description>
    <PackageTags>ashlar;ai;api;orchestration</PackageTags>
    <RepositoryUrl>https://github.com/IanFrelinger/Ashlar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ashlar.Tests.Infrastructure" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!-- OTLP export (traces + metrics), active only when OTEL_EXPORTER_OTLP_ENDPOINT is set. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <ProjectReference Include="../../../src/Ashlar.BackgroundAgents.HostRunners/Ashlar.BackgroundAgents.HostRunners.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Brick.Contracts/Ashlar.Brick.Contracts.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Contracts/Ashlar.Contracts.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Hosting/Ashlar.Hosting.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Ingress.DynamoDb/Ashlar.Ingress.DynamoDb.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Ingress.AwsSns/Ashlar.Ingress.AwsSns.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Infrastructure/Ashlar.Infrastructure.csproj" />
    <!-- Agent-protocol adapters (feature-flagged off by default). Note: the A2A projects are
         IsPackable=false while the A2A SDK is prerelease; Ashlar.API is not packed by any release
         workflow today, but if it ever is, these references must be revisited (NU5104). -->
    <ProjectReference Include="../../../src/Ashlar.Mcp.Server/Ashlar.Mcp.Server.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Mcp.Client/Ashlar.Mcp.Client.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Transport.A2A/Ashlar.Transport.A2A.csproj" />
    <ProjectReference Include="../../../src/Ashlar.Transport.A2A.Server/Ashlar.Transport.A2A.Server.csproj" />
  </ItemGroup>

</Project>
