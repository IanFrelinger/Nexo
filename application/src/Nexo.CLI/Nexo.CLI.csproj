<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nexo</ToolCommandName>
    <IsPackable>true</IsPackable>
    <AssemblyTitle>Nexo CLI</AssemblyTitle>
    <AssemblyDescription>AI-Enhanced Development Environment Orchestration Platform CLI</AssemblyDescription>
    <AssemblyCompany>Nexo</AssemblyCompany>
    <AssemblyProduct>Nexo CLI</AssemblyProduct>
    <AssemblyCopyright>Copyright © Nexo 2024</AssemblyCopyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <PackageId>Nexo.CLI</PackageId>
    <Description>Provider-agnostic LEGO-style feature factory CLI</Description>
    <PackageTags>nexo;ai;feature-factory;offline-first</PackageTags>
    <RepositoryUrl>https://github.com/IanFrelinger/Nexo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageProjectUrl>https://github.com/IanFrelinger/Nexo</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Nexo.Core.Domain/Nexo.Core.Domain.csproj" />
    <ProjectReference Include="../../../src/Nexo.Core.Application/Nexo.Core.Application.csproj" />
    <ProjectReference Include="../../../src/Nexo.Adapters.Models/Nexo.Adapters.Models.csproj" />
    <ProjectReference Include="../../../src/Nexo.Hosting/Nexo.Hosting.csproj" />
    <ProjectReference Include="../../../src/Nexo.Infrastructure/Nexo.Infrastructure.csproj" />
    <ProjectReference Include="../../../src/Nexo.Bricks.Owasp/Nexo.Bricks.Owasp.csproj" />
    <ProjectReference Include="../../../src/Nexo.Orchestration/Nexo.Orchestration.csproj" />
    <ProjectReference Include="../../../src/Nexo.BackgroundAgents/Nexo.BackgroundAgents.csproj" />
    <ProjectReference Include="../../../src/Nexo.BackgroundAgents.HostRunners/Nexo.BackgroundAgents.HostRunners.csproj" />
    <ProjectReference Include="../../../src/Nexo.Policies.Dev/Nexo.Policies.Dev.csproj" />
    <ProjectReference Include="../../../src/Nexo.Tools.Dev/Nexo.Tools.Dev.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexo.Tests.CLI" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../src/Nexo.Hosting/GlobalUsings.Infrastructure.Sdk.cs" Link="GlobalUsings.Infrastructure.Sdk.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../samples/templates/brick/**/*" LogicalName="Nexo.CLI.Templates.Brick/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeTestProjectReferences)' != 'false'">
    <!-- Test projects for runtime discovery (excluding CLI to avoid circular dependency) -->
    <ProjectReference Include="../../../src/Nexo.Tests.Domain/Nexo.Tests.Domain.csproj" />
    <ProjectReference Include="../../../src/Nexo.Tests.Application/Nexo.Tests.Application.csproj" />
    <ProjectReference Include="../../../src/Nexo.Tests.Infrastructure/Nexo.Tests.Infrastructure.csproj" />
  </ItemGroup>
  

</Project>
