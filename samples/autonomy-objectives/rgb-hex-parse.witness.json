{
  "brickId": "rgb-hex-parse",
  "cases": [
    {
      "input": { "hex": "#1A2B3C" },
      "expectedOutput": { "isValid": true, "red": 26, "green": 43, "blue": 60, "normalized": "#1a2b3c" }
    },
    {
      "input": { "hex": "ffffff" },
      "expectedOutput": { "isValid": true, "red": 255, "green": 255, "blue": 255, "normalized": "#ffffff" }
    },
    {
      "input": { "hex": "#000000" },
      "expectedOutput": { "isValid": true, "red": 0, "green": 0, "blue": 0, "normalized": "#000000" }
    },
    {
      "input": { "hex": "#abc" },
      "expectedOutput": { "isValid": false, "red": 0, "green": 0, "blue": 0, "normalized": "" }
    },
    {
      "input": { "hex": "#12345G" },
      "expectedOutput": { "isValid": false, "red": 0, "green": 0, "blue": 0, "normalized": "" }
    },
    {
      "input": { "hex": " #1a2b3c" },
      "expectedOutput": { "isValid": false, "red": 0, "green": 0, "blue": 0, "normalized": "" }
    },
    {
      "input": { "hex": "#1a2b3cff" },
      "expectedOutput": { "isValid": false, "red": 0, "green": 0, "blue": 0, "normalized": "" }
    },
    {
      "input": { "hex": "" },
      "expectedOutput": { "isValid": false, "red": 0, "green": 0, "blue": 0, "normalized": "" }
    }
  ]
}
