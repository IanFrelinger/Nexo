{
  "name": "com.nexo.director-studio",
  "version": "1.0.0",
  "displayName": "Director Studio",
  "description": "Unity Editor tool for creating game slices from natural-language briefs across any genre. Built on Nexo agent-first orchestration framework with offline AI capabilities.",
  "unity": "2022.3",
  "unityRelease": "0f1",
  "dependencies": {
    "com.unity.nuget.newtonsoft-json": "3.2.1",
    "com.unity.addressables": "1.21.19",
    "com.unity.test-framework": "1.3.8",
    "com.unity.textmeshpro": "3.0.6"
  },
  "keywords": [
    "game-development",
    "ai",
    "natural-language",
    "game-slices",
    "nexo",
    "agent-first",
    "offline-ai",
    "ollama",
    "comfyui",
    "piper",
    "unity-editor",
    "game-design"
  ],
  "author": {
    "name": "Nexo Team",
    "email": "team@nexo.dev",
    "url": "https://github.com/nexo-framework"
  },
  "license": "MIT",
  "homepage": "https://github.com/nexo-framework/director-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexo-framework/director-studio.git"
  },
  "bugs": {
    "url": "https://github.com/nexo-framework/director-studio/issues"
  },
  "samples": [
    {
      "displayName": "Basic Game Slice Generation",
      "description": "Simple example of generating a platformer game slice",
      "path": "Samples~/BasicGameSlice"
    },
    {
      "displayName": "FPS Game Slice",
      "description": "Example of generating an FPS game slice with weapons and enemies",
      "path": "Samples~/FPSGameSlice"
    },
    {
      "displayName": "RPG Game Slice",
      "description": "Example of generating an RPG game slice with dialogue and quests",
      "path": "Samples~/RPGGameSlice"
    }
  ],
  "changelog": {
    "1.0.0": [
      "Initial release of Director Studio",
      "Natural language game slice generation",
      "Offline AI adapters (Ollama, ComfyUI, Piper)",
      "Comprehensive validation system",
      "Genre-agnostic design",
      "Staging and promotion workflow",
      "Auto-fix suggestions",
      "Complete test coverage"
    ]
  },
  "documentationUrl": "https://github.com/nexo-framework/director-studio/blob/main/docs/README.md",
  "support": {
    "url": "https://github.com/nexo-framework/director-studio/issues",
    "email": "support@nexo.dev"
  },
  "category": "Game Development",
  "type": "tool",
  "hideInEditor": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "dotnet test Tests/EditMode/",
    "test:playmode": "dotnet test Tests/PlayMode/",
    "test:headless": "dotnet test Tests/EditMode/ --filter Category=Headless",
    "build": "dotnet build --configuration Release",
    "coverage": "dotnet test --collect:\"XPlat Code Coverage\" --results-directory TestResults",
    "analyze": "dotnet build --verbosity normal | tee build-output.txt"
  },
  "engines": {
    "unity": ">=2022.3.0",
    "dotnet": ">=8.0.0"
  },
  "platforms": {
    "windows": {
      "editor": ">=2022.3.0"
    },
    "macos": {
      "editor": ">=2022.3.0"
    },
    "linux": {
      "editor": ">=2022.3.0"
    }
  },
  "features": [
    "Natural Language Processing",
    "AI-Powered Game Generation",
    "Offline AI Integration",
    "Genre-Agnostic Design",
    "Comprehensive Validation",
    "Auto-Fix Suggestions",
    "Asset Generation",
    "Staging & Promotion",
    "Performance Budgets",
    "Accessibility Support"
  ],
  "requirements": {
    "minimum": {
      "unity": "2022.3.0f1",
      "dotnet": "8.0.0"
    },
    "recommended": {
      "unity": "2023.1.0f1",
      "dotnet": "8.0.0"
    }
  },
  "compatibility": {
    "unity": ">=2022.3.0",
    "dotnet": ">=8.0.0"
  },
  "size": {
    "package": "~2.5MB",
    "runtime": "~1.2MB",
    "editor": "~1.3MB"
  },
  "performance": {
    "memory": "~50MB",
    "cpu": "Low impact",
    "gpu": "No GPU usage"
  },
  "security": {
    "permissions": [
      "File system access (Assets/Generated/** only)",
      "Network access (for AI adapters)",
      "Process execution (for Piper TTS)"
    ],
    "constraints": [
      "All generated assets under Assets/Generated/**",
      "Maximum 200MB per generation run",
      "Staging workflow for atomic operations"
    ]
  },
  "testing": {
    "coverage": ">=80%",
    "testTypes": [
      "Unit Tests",
      "Integration Tests",
      "Smoke Tests",
      "PlayMode Tests",
      "Headless Tests"
    ],
    "frameworks": [
      "NUnit",
      "Unity Test Framework"
    ]
  },
  "ci": {
    "workflows": [
      "Build",
      "Tests",
      "Analyzers",
      "Coverage"
    ],
    "platforms": [
      "Windows",
      "macOS",
      "Linux"
    ],
    "unityVersions": [
      "2022.3.0f1",
      "2023.1.0f1"
    ]
  }
}