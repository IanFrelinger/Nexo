{
  "schemaVersion": 1,
  "maxParallel": 2,
  "lanes": [
    {
      "id": "code",
      "title": "Code and build integrity",
      "objective": "Build the root release solution and enforce dependency boundaries. Product and external-consumer graphs are covered by their dedicated test and packaging lanes.",
      "required": true,
      "timeoutSeconds": 2400,
      "steps": [
        {
          "name": "release-build",
          "command": [
            "dotnet",
            "build",
            "Ashlar.sln",
            "-c",
            "Release",
            "--nologo"
          ],
          "timeoutSeconds": 1800
        },
        {
          "name": "dependency-boundary",
          "command": [
            "python3",
            "scripts/verify-open-commercial-dependency-boundary.py"
          ],
          "environment": {
            "DEPENDENCY_BOUNDARY_STRICT": "1"
          },
          "timeoutSeconds": 300
        }
      ]
    },
    {
      "id": "tests",
      "title": "Test and CI truth",
      "objective": "Run the required certification suite, every CLI test (including bridge rows), and product tests. Timeouts and zero-test outcomes are blockers, not skips.",
      "required": true,
      "timeoutSeconds": 3900,
      "steps": [
        {
          "name": "cert-gate",
          "command": [
            "bash",
            "scripts/run-cert-gate.sh"
          ],
          "timeoutSeconds": 1200
        },
        {
          "name": "complete-cli-suite",
          "command": [
            "python3",
            "scripts/run-dotnet-test-counted.py",
            "--project",
            "application/src/Ashlar.Tests.CLI/Ashlar.Tests.CLI.csproj",
            "--expected-prefix",
            "Ashlar.Tests.CLI.",
            "--min-tests",
            "200",
            "--",
            "--filter",
            "FullyQualifiedName!~UnitTestBridgeTests",
            "--blame-hang-timeout",
            "300s",
            "--blame-hang-dump-type",
            "none",
            "--nologo"
          ],
          "timeoutSeconds": 900
        },
        {
          "name": "product-scaffolds",
          "command": [
            "python3",
            "scripts/run-dotnet-test-counted.py",
            "--project",
            "products/Ashlar.Products.sln",
            "--expected-prefix",
            "Ashlar.Tests.Products.",
            "--min-tests",
            "12",
            "--",
            "--blame-hang-timeout",
            "120s",
            "--blame-hang-dump-type",
            "none",
            "--nologo"
          ],
          "timeoutSeconds": 900
        },
        {
          "name": "distributed-contracts",
          "command": [
            "python3",
            "scripts/run-dotnet-test-counted.py",
            "--project",
            "src/Ashlar.Tests.Contracts/Ashlar.Tests.Contracts.csproj",
            "--expected-prefix",
            "Ashlar.Tests.Contracts.DistributedContractTests.",
            "--min-tests",
            "5",
            "--",
            "--filter",
            "FullyQualifiedName~DistributedContractTests",
            "--blame-hang-timeout",
            "120s",
            "--blame-hang-dump-type",
            "none",
            "--nologo"
          ],
          "timeoutSeconds": 600
        }
      ]
    },
    {
      "id": "security",
      "title": "Security and trust",
      "objective": "Run trust, authentication, supply-chain, and zero-egress proof. A scan failure, vulnerable dependency, or skipped air-gapped container proof blocks release.",
      "required": true,
      "timeoutSeconds": 4500,
      "exclusiveResources": ["docker"],
      "steps": [
        {
          "name": "docker-required",
          "command": [
            "docker",
            "info"
          ],
          "timeoutSeconds": 60
        },
        {
          "name": "security-gate-full",
          "command": [
            "make",
            "security-gate-full"
          ],
          "environment": {
            "SECURITY_GATE_AIRGAPPED_CONTAINER": "1",
            "SECURITY_GATE_SKIP_PRIOR": "1",
            "SECURITY_GATE_STRICT_SUPPLY_CHAIN": "1"
          },
          "timeoutSeconds": 3600
        },
        {
          "name": "full-solution-vulnerability-scan",
          "command": [
            "python3",
            "scripts/verify-no-vulnerable-packages.py",
            "Ashlar.sln"
          ],
          "timeoutSeconds": 600
        }
      ]
    },
    {
      "id": "packaging",
      "title": "Packaging and external consumption",
      "objective": "Pack the exact candidate version, restore it in an isolated consumer, and verify the external brick-host-client shape without publishing anything.",
      "required": true,
      "timeoutSeconds": 3900,
      "steps": [
        {
          "name": "release-preflight",
          "command": [
            "bash",
            "scripts/release-preflight-local.sh",
            "{version}"
          ],
          "timeoutSeconds": 2400
        },
        {
          "name": "external-product-shape",
          "command": [
            "bash",
            "scripts/verify-external-product-shape.sh"
          ],
          "environment": {
            "ASHLAR_EXTERNAL_PRODUCT_VERIFY_VERSION": "{version}",
            "ASHLAR_EXTERNAL_PRODUCT_VERIFY_WORK": "{workspace}/.ashlar/release-manager/external-product"
          },
          "timeoutSeconds": 1200
        }
      ]
    },
    {
      "id": "documentation",
      "title": "Documentation and product claims",
      "objective": "Fail claims that drift from published versions, public API promises, repository layout, or UAT. Documentation is part of the release artifact.",
      "required": true,
      "timeoutSeconds": 2400,
      "steps": [
        {
          "name": "published-version-claims",
          "command": [
            "bash",
            "scripts/verify-docs-published-version.sh"
          ],
          "timeoutSeconds": 300
        },
        {
          "name": "public-api-and-documentation-uat",
          "command": [
            "bash",
            "tests/uat/tier9.sh"
          ],
          "environment": {
            "UAT_OUT": "{workspace}/.ashlar/release-manager/uat",
            "UAT_REPO_DIR": "{workspace}"
          },
          "timeoutSeconds": 600
        },
        {
          "name": "onboarding-doc-conventions",
          "command": [
            "python3",
            "scripts/run-dotnet-test-counted.py",
            "--project",
            "src/Ashlar.Tests.Infrastructure/Ashlar.Tests.Infrastructure.csproj",
            "--expected-prefix",
            "Ashlar.Tests.Infrastructure.",
            "--min-tests",
            "50",
            "--",
            "--filter",
            "FullyQualifiedName~PublishedVersionDocsLintTests|FullyQualifiedName~Onboarding",
            "--blame-hang-timeout",
            "120s",
            "--blame-hang-dump-type",
            "none",
            "--nologo"
          ],
          "timeoutSeconds": 1200
        }
      ]
    },
    {
      "id": "operations",
      "title": "Operations and deployment",
      "objective": "Prove the non-Docker full-stack gate, both production-shaped Compose lanes, and disaster recovery. A missing engine is a blocker for a production release.",
      "required": true,
      "timeoutSeconds": 7800,
      "exclusiveResources": ["docker"],
      "steps": [
        {
          "name": "full-stack-no-docker",
          "command": [
            "bash",
            "scripts/ashlar-ready-gate.sh"
          ],
          "environment": {
            "ASHLAR_READY_SKIP_DOCKER": "1"
          },
          "timeoutSeconds": 3000
        },
        {
          "name": "portal-production-dry-run",
          "command": [
            "bash",
            "scripts/prod-dry-run.sh",
            "--portal"
          ],
          "environment": {
            "COMPOSE_PROJECT_NAME": "{run_slug}-portal"
          },
          "timeoutSeconds": 1200
        },
        {
          "name": "agent-server-production-dry-run",
          "command": [
            "bash",
            "scripts/prod-dry-run.sh",
            "--agent-server"
          ],
          "environment": {
            "COMPOSE_PROJECT_NAME": "{run_slug}-agent"
          },
          "timeoutSeconds": 1200
        },
        {
          "name": "disaster-recovery",
          "command": [
            "make",
            "dr-gate-full"
          ],
          "timeoutSeconds": 1800
        }
      ]
    }
  ]
}
