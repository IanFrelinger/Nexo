{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Nexo": {
    "PatternStorePath": "nexo-patterns.db",
    "RegisterBackgroundAgentHostedService": true,
    "Security": {
      "AuthorizationMode": "ApiKey",
      "AuthorizationScope": "MutatingApi",
      "ApiKey": "fleet-host-dev-key",
      "ExposureProfile": "Lan"
    },
    "Mesh": {
      "Fleet": {
        "RequirePeerRegistrationKey": false
      },
      "Persistence": {
        "Provider": "InMemory"
      }
    }
  }
}
