<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <NexoCommercialProject>true</NexoCommercialProject>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GameDirector.Host</RootNamespace>
    <AssemblyName>GameDirector.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\..\application\src\Nexo.API\wwwroot\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <ProjectReference Include="..\Nexo.Commercial.GameDirector.Agents\GameDirector.Agents.csproj" />
    <ProjectReference Include="..\Nexo.Commercial.GameDirector.Bricks\GameDirector.Bricks.csproj" />
    <ProjectReference Include="..\Nexo.Commercial.GameDirector.Domain\GameDirector.Domain.csproj" />
    <ProjectReference Include="..\Nexo.Commercial.GameDirector.Mcp\GameDirector.Mcp.csproj" />
    <ProjectReference Include="..\..\..\application\src\Nexo.API\Nexo.API.csproj" />
    <ProjectReference Include="..\..\..\src\Nexo.Client\Nexo.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Nexo.Hosting\Nexo.Hosting.csproj" />
  </ItemGroup>

</Project>
