<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AshlarCommercialProject>true</AshlarCommercialProject>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GameDirector.Host</RootNamespace>
    <AssemblyName>GameDirector.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\application\src\Ashlar.API\wwwroot\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <ProjectReference Include="..\Ashlar.Commercial.GameDirector.Agents\GameDirector.Agents.csproj" />
    <ProjectReference Include="..\Ashlar.Commercial.GameDirector.Bricks\GameDirector.Bricks.csproj" />
    <ProjectReference Include="..\Ashlar.Commercial.GameDirector.Domain\GameDirector.Domain.csproj" />
    <ProjectReference Include="..\Ashlar.Commercial.GameDirector.Mcp\GameDirector.Mcp.csproj" />
    <ProjectReference Include="..\..\..\application\src\Ashlar.API\Ashlar.API.csproj" />
    <ProjectReference Include="..\..\..\src\Ashlar.Client\Ashlar.Client.csproj" />
    <ProjectReference Include="..\..\..\src\Ashlar.Hosting\Ashlar.Hosting.csproj" />
  </ItemGroup>

</Project>
