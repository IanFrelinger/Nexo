<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NexoCommercialProject>true</NexoCommercialProject>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GameDirector.Bricks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexo.Commercial.GameDirector.Domain\GameDirector.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Nexo.Abstractions\Nexo.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\Nexo.Core.Domain\Nexo.Core.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Nexo.Core.Application\Nexo.Core.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Nexo.Infrastructure\Nexo.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Brick contract drift rule (NEXO0001/NEXO0002): keeps BrickInterface and the
       Get/Set keys a brick actually uses from silently diverging. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Nexo.Analyzers\Nexo.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
