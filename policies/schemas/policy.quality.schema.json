{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QualityPolicy",
  "type": "object",
  "required": ["meta", "gates", "scoring"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "version"],
      "properties": { 
        "id": { "type": "string" }, 
        "version": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "gates": { 
      "type": "object",
      "properties": {
        "compile": {
          "type": "object",
          "properties": {
            "must_succeed": { "type": "boolean" }
          }
        },
        "tests": {
          "type": "object",
          "properties": {
            "must_pass": { "type": "boolean" },
            "min_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "style": {
          "type": "object",
          "properties": {
            "max_warnings": { "type": "number" },
            "treat_analyzers_as_errors": { "type": "boolean" }
          }
        },
        "complexity": {
          "type": "object",
          "properties": {
            "max_cyclomatic_average": { "type": "number" },
            "max_cyclomatic_per_method": { "type": "number" }
          }
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "disallow_prerelease": { "type": "boolean" },
            "audit": {
              "type": "object",
              "properties": {
                "severity_fail_at": { "enum": ["low", "moderate", "high", "critical"] }
              }
            }
          }
        },
        "commits": {
          "type": "object",
          "properties": {
            "conventional_commits": { "type": "boolean" }
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": ["weights", "pass_threshold"],
      "properties": {
        "weights": { 
          "type": "object",
          "properties": {
            "compile": { "type": "number", "minimum": 0, "maximum": 1 },
            "tests": { "type": "number", "minimum": 0, "maximum": 1 },
            "style": { "type": "number", "minimum": 0, "maximum": 1 },
            "complexity": { "type": "number", "minimum": 0, "maximum": 1 },
            "dependencies": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "pass_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "language_overrides": { 
      "type": "object",
      "patternProperties": {
        "^[a-z]+$": {
          "type": "object",
          "properties": {
            "analyzer_ruleset": { "type": "string" },
            "roslyn": {
              "type": "object",
              "properties": {
                "treat_warnings_as_errors": { "type": "boolean" },
                "required_diagnostics": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "disabled_diagnostics": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "outputs": { 
      "type": "object",
      "properties": {
        "report_dir": { "type": "string" },
        "formats": {
          "type": "array",
          "items": { "enum": ["json", "md", "sarif"] }
        },
        "sarif": { "type": "boolean" }
      }
    }
  }
}
