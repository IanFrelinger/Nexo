{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexo.dev/schemas/policy.safety.v0.1.json",
  "title": "SafetyPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "sandbox", "rules"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "version"],
      "properties": { 
        "id": { "type": "string" }, 
        "version": { "type": "string" },
        "description": { "type": "string" },
        "severity_scale": {
          "type": "array",
          "items": { "enum": ["info", "warn", "error", "block"] }
        }
      }
    },
    "sandbox": { 
      "type": "object",
      "properties": {
        "filesystem": { "type": "object" },
        "process": { "type": "object" },
        "network": { "type": "object" },
        "env": { "type": "object" }
      }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "outputs": { 
      "type": "object",
      "properties": {
        "report_dir": { "type": "string" },
        "formats": {
          "type": "array",
          "items": { "enum": ["json", "md", "sarif"] }
        },
        "sarif": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "kind", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "description": { "type": "string" },
        "kind": { "enum": ["filesystem", "process", "network", "content", "license"] },
        "action": { "enum": ["info", "warn", "error", "block"] },
        "severity": { "enum": ["info", "warn", "error", "block"] },
        "patterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allow": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deny": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
