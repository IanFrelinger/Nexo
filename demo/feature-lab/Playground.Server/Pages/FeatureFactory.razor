@page "/feature-factory"
@using Playground.Server.Services
@using Microsoft.AspNetCore.Components.Web
@inject FeatureFactoryService FeatureFactoryService
@inject Microsoft.JSInterop.IJSRuntime JSRuntime

<PageTitle>Feature Factory - Nexo Feature Lab</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="display-4">🏭 NEXO Feature Factory</h1>
            <p class="lead">AI-native feature generation system that transforms natural language into production-ready code</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>🚀 Generate New Feature</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="featureDescription" class="form-label">Describe your feature in natural language:</label>
                        <textarea class="form-control" id="featureDescription" rows="4" 
                                  @bind="featureDescription" 
                                  placeholder="e.g., Create a user management system with authentication, profile management, and role-based access control"></textarea>
                    </div>
                    
                    <div class="mb-3">
                        <label for="platform" class="form-label">Target Platform:</label>
                        <select class="form-select" id="platform" @bind="selectedPlatform">
                            <option value=".NET">.NET</option>
                            <option value="Unity">Unity</option>
                            <option value="Web">Web</option>
                            <option value="iOS">iOS</option>
                            <option value="Android">Android</option>
                            <option value="Cross-Platform">Cross-Platform</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Additional Requirements:</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cleanArchitecture" @bind="cleanArchitecture">
                            <label class="form-check-label" for="cleanArchitecture">
                                Clean Architecture
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="unitTests" @bind="unitTests">
                            <label class="form-check-label" for="unitTests">
                                Unit Tests
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="integrationTests" @bind="integrationTests">
                            <label class="form-check-label" for="integrationTests">
                                Integration Tests
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="documentation" @bind="documentation">
                            <label class="form-check-label" for="documentation">
                                Documentation
                            </label>
                        </div>
                    </div>

                    <button class="btn btn-primary btn-lg w-100" @onclick="GenerateFeature" disabled="@isGenerating">
                        @if (isGenerating)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <text>Generating Feature...</text>
                        }
                        else
                        {
                            <text>🚀 Generate Feature</text>
                        }
                    </button>
                </div>
            </div>

            @if (generationResult != null)
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h5>📊 Generation Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                <strong>Status:</strong> 
                                <span class="badge @(generationResult.Status == "Completed" ? "bg-success" : generationResult.Status == "Failed" ? "bg-danger" : "bg-warning")">
                                    @generationResult.Status
                                </span>
                            </div>
                            <div class="col-6">
                                <strong>Duration:</strong> @(generationResult.Duration.ToString("F0"))ms
                            </div>
                        </div>
                        @if (generationResult.ArchitectureDecision != null)
                        {
                            <div class="mt-2">
                                <strong>Strategy:</strong> @generationResult.ArchitectureDecision.Strategy
                                <span class="text-muted">(@generationResult.ArchitectureDecision.ConfidenceScore.ToString("F1")% confidence)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-md-6">
            @if (isGenerating || generationResult != null)
            {
                <div class="card">
                    <div class="card-header">
                        <h5>🤖 AI Agent Coordination</h5>
                    </div>
                    <div class="card-body">
                        @if (isGenerating)
                        {
                            <div class="text-center">
                                <div class="spinner-border text-primary mb-3" role="status"></div>
                                <p>AI agents are analyzing your requirements and generating code...</p>
                            </div>
                        }

                        @if (generationResult?.Steps != null)
                        {
                            <div class="timeline">
                                @foreach (var step in generationResult.Steps)
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-marker @(step.Status == "Completed" ? "bg-success" : step.Status == "Failed" ? "bg-danger" : "bg-warning")"></div>
                                        <div class="timeline-content">
                                            <h6>@step.StepName</h6>
                                            <p class="text-muted small">@step.Description</p>
                                            @if (!string.IsNullOrEmpty(step.Output))
                                            {
                                                <p class="small text-success">@step.Output</p>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (generationResult?.DomainAnalysis != null)
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <h5>🏗️ Domain Analysis</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                <h6>Entities (@generationResult.DomainAnalysis.Entities.Count)</h6>
                                <ul class="list-unstyled small">
                                    @foreach (var entity in generationResult.DomainAnalysis.Entities)
                                    {
                                        <li>• @entity.Name</li>
                                    }
                                </ul>
                            </div>
                            <div class="col-6">
                                <h6>Value Objects (@generationResult.DomainAnalysis.ValueObjects.Count)</h6>
                                <ul class="list-unstyled small">
                                    @foreach (var vo in generationResult.DomainAnalysis.ValueObjects)
                                    {
                                        <li>• @vo.Name</li>
                                    }
                                </ul>
                            </div>
                        </div>
                        <div class="mt-2">
                            <h6>Business Rules (@generationResult.DomainAnalysis.BusinessRules.Count)</h6>
                            <ul class="list-unstyled small">
                                @foreach (var rule in generationResult.DomainAnalysis.BusinessRules.Take(3))
                                {
                                    <li>• @rule.Description</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (generationResult?.GeneratedCode != null)
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5>💻 Generated Code</h5>
                        <small class="text-muted">@generationResult.GeneratedCode.Files.Count files across @string.Join(", ", generationResult.GeneratedCode.Platforms)</small>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <h6>Generated Files</h6>
                                <div class="list-group list-group-flush">
                                    @foreach (var file in generationResult.GeneratedCode.Files)
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                            <div>
                                                <code class="small">@file.Path</code>
                                                <br>
                                                <small class="text-muted">@file.Type</small>
                                            </div>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewFile(file)">
                                                View
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-md-8">
                                @if (selectedFile != null)
                                {
                                    <h6>@selectedFile.Path</h6>
                                    <pre class="bg-light p-3 rounded"><code>@selectedFile.Content</code></pre>
                                }
                                else
                                {
                                    <div class="text-center text-muted">
                                        <i class="fas fa-code fa-3x mb-3"></i>
                                        <p>Select a file to view its generated code</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (generationResult?.GeneratedTests != null)
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5>🧪 Generated Tests</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Unit Tests (@generationResult.GeneratedTests.UnitTests.Count)</h6>
                                <ul class="list-unstyled">
                                    @foreach (var test in generationResult.GeneratedTests.UnitTests)
                                    {
                                        <li>✅ @test</li>
                                    }
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6>Integration Tests (@generationResult.GeneratedTests.IntegrationTests.Count)</h6>
                                <ul class="list-unstyled">
                                    @foreach (var test in generationResult.GeneratedTests.IntegrationTests)
                                    {
                                        <li>✅ @test</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 20px;
    }

    .timeline-marker {
        position: absolute;
        left: -25px;
        top: 5px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 0 0 2px #dee2e6;
    }

    .timeline-content {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        border-left: 3px solid #007bff;
    }
</style>

@code {
    private string featureDescription = "";
    private string selectedPlatform = ".NET";
    private bool cleanArchitecture = true;
    private bool unitTests = true;
    private bool integrationTests = true;
    private bool documentation = true;
    private bool isGenerating = false;
    private FeatureGenerationResult? generationResult;
    private GeneratedFile? selectedFile;

    private async Task GenerateFeature()
    {
        if (string.IsNullOrWhiteSpace(featureDescription))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please enter a feature description");
            return;
        }

        isGenerating = true;
        generationResult = null;
        selectedFile = null;

        try
        {
            var request = new FeatureGenerationRequest
            {
                Description = featureDescription,
                Platform = selectedPlatform,
                Requirements = new List<string>()
            };

            if (cleanArchitecture) request.Requirements.Add("Clean Architecture");
            if (unitTests) request.Requirements.Add("Unit Tests");
            if (integrationTests) request.Requirements.Add("Integration Tests");
            if (documentation) request.Requirements.Add("Documentation");

            generationResult = await FeatureFactoryService.GenerateFeatureAsync(request);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            isGenerating = false;
        }
    }

    private void ViewFile(GeneratedFile file)
    {
        selectedFile = file;
    }
}
