@page "/inspect"
@using Playground.Server.Models
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http

<PageTitle>Inspect - Nexo Feature Lab</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="display-4">🔍 Inspect & Export</h1>
            <p class="lead">Review approvals, audit trails, and export runnable artifacts</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>⏸️ Approvals Queue</h5>
                </div>
                <div class="card-body">
                    @if (PendingApprovals.Any())
                    {
                        @foreach (var approval in PendingApprovals)
                        {
                            <div class="card mb-3">
                                <div class="card-body">
                                    <h6 class="card-title">Approval Request</h6>
                                    <p class="card-text">@approval.Reason</p>
                                    <small class="text-muted">
                                        Requested: @approval.RequestedAt.ToString("HH:mm:ss")
                                    </small>
                                    <div class="mt-2">
                                        <button class="btn btn-success btn-sm" @onclick="() => ApproveAsync(approval.ApprovalId, approval.StepId)">
                                            Approve
                                        </button>
                                        <button class="btn btn-danger btn-sm ms-2" @onclick="() => RejectAsync(approval.ApprovalId, approval.StepId)">
                                            Reject
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="oi oi-check" style="font-size: 2rem;"></i>
                            <p class="mt-2">No pending approvals</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>📊 Run Details</h5>
                </div>
                <div class="card-body">
                    @if (RecentRuns.Any())
                    {
                        <div class="list-group">
                            @foreach (var run in RecentRuns)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@GetRunTitle(run)</h6>
                                        <small>@run.StartTime.ToString("HH:mm:ss")</small>
                                    </div>
                                    <p class="mb-1">
                                        <span class="badge @GetStatusBadgeClass(run.Completed)">
                                            @GetStatusText(run.Completed)
                                        </span>
                                        @run.Mode | @run.Provider
                                    </p>
                                    <small>@run.Steps.Count steps | @GetDuration(run)</small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="oi oi-magnifying-glass" style="font-size: 2rem;"></i>
                            <p class="mt-2">No recent runs</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>📦 Export Artifacts</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-body text-center">
                                    <i class="oi oi-terminal" style="font-size: 3rem; color: #007bff;"></i>
                                    <h5 class="mt-3">CLI Export</h5>
                                    <p class="text-muted">Generate command-line interface for your features</p>
                                    <button class="btn btn-primary" @onclick="() => ExportCli()" disabled="@IsExporting">
                                        @if (IsExporting && ExportType == "CLI")
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        Export CLI
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-body text-center">
                                    <i class="oi oi-layers" style="font-size: 3rem; color: #28a745;"></i>
                                    <h5 class="mt-3">Docker Export</h5>
                                    <p class="text-muted">Create containerized deployment packages</p>
                                    <button class="btn btn-success" @onclick="() => ExportDocker()" disabled="@IsExporting">
                                        @if (IsExporting && ExportType == "Docker")
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        Export Docker
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-body text-center">
                                    <i class="oi oi-download" style="font-size: 3rem; color: #6f42c1;"></i>
                                    <h5 class="mt-3">Export Both</h5>
                                    <p class="text-muted">Generate CLI and Docker packages together</p>
                                    <button class="btn btn-primary" @onclick="() => ExportBoth()" disabled="@IsExporting">
                                        @if (IsExporting && ExportType == "Both")
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        Export Both
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (ExportResult != null)
                    {
                        <div class="mt-4">
                            <div class="alert @(ExportResult.Success ? "alert-success" : "alert-danger")">
                                <h6>Export @(ExportResult.Success ? "Successful" : "Failed")</h6>
                                @if (ExportResult.Success)
                                {
                                    <p>Your @ExportResult.Type.ToLower() export has been created successfully!</p>
                                    <p><strong>Location:</strong> @ExportResult.Path</p>
                                    
                                    @if (ExportResult.Type == "Both")
                                    {
                                        <div class="row">
                                            <div class="col-md-6">
                                                <strong>CLI:</strong> @ExportResult.CliPath
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Docker:</strong> @ExportResult.DockerPath
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p>Export failed: @ExportResult.Error</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (SelectedRun != null)
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5>📋 Detailed Audit Trail</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Step</th>
                                        <th>Status</th>
                                        <th>Duration</th>
                                        <th>Provider</th>
                                        <th>Timestamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var step in SelectedRun.Steps)
                                    {
                                        <tr>
                                            <td>@step.StepName</td>
                                            <td>
                                                <span class="badge @GetStepBadgeClass(step.Status)">
                                                    @step.Status
                                                </span>
                                            </td>
                                            <td>@step.Duration.TotalMilliseconds.ToString("F0")ms</td>
                                            <td>@(step.Provider ?? "-")</td>
                                            <td>@step.Timestamp.ToString("HH:mm:ss.fff")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ApprovalEvent> PendingApprovals { get; set; } = new();
    private List<RunResult> RecentRuns { get; set; } = new();
    private RunResult? SelectedRun { get; set; }
    private bool IsExporting { get; set; } = false;
    private string ExportType { get; set; } = "";
    private ExportResultInfo? ExportResult { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        // Load pending approvals and recent runs
        // This would typically call the API endpoints
        await Task.Delay(100); // Simulate loading
    }

    private async Task ApproveAsync(string approvalId, string stepId)
    {
        var request = new ApprovalRequest(stepId, "Approved via UI");
        await Http.PostAsJsonAsync($"/api/run/{approvalId}/approve", request);
        await LoadData();
    }

    private async Task RejectAsync(string approvalId, string stepId)
    {
        var request = new ApprovalRequest(stepId, "Rejected via UI");
        await Http.PostAsJsonAsync($"/api/run/{approvalId}/approve", request);
        await LoadData();
    }

    private async Task ExportCli()
    {
        await Export("CLI", "smart-reply");
    }

    private async Task ExportDocker()
    {
        await Export("Docker", "smart-reply");
    }

    private async Task ExportBoth()
    {
        await Export("Both", "smart-reply");
    }

    private async Task Export(string type, string feature)
    {
        IsExporting = true;
        ExportType = type;
        
        try
        {
            var outputDir = Path.Combine(Path.GetTempPath(), "nexo-exports", Guid.NewGuid().ToString());
            Directory.CreateDirectory(outputDir);

            // Simulate export process
            await Task.Delay(2000);

            ExportResult = new ExportResultInfo
            {
                Success = true,
                Type = type,
                Path = outputDir,
                CliPath = type == "Both" || type == "CLI" ? Path.Combine(outputDir, "cli") : null,
                DockerPath = type == "Both" || type == "Docker" ? Path.Combine(outputDir, "docker") : null
            };
        }
        catch (Exception ex)
        {
            ExportResult = new ExportResultInfo
            {
                Success = false,
                Type = type,
                Error = ex.Message
            };
        }
        finally
        {
            IsExporting = false;
        }
    }

    private string GetRunTitle(RunResult run) => $"Run {run.RunId[..8]}...";
    private string GetStatusBadgeClass(bool completed) => completed ? "bg-success" : "bg-warning";
    private string GetStatusText(bool completed) => completed ? "Completed" : "Running";
    private string GetStepBadgeClass(string status) => status switch
    {
        "Completed" => "bg-success",
        "Failed" => "bg-danger",
        "Running" => "bg-warning",
        _ => "bg-secondary"
    };
    
    private string GetDuration(RunResult run)
    {
        if (run.EndTime.HasValue)
        {
            return (run.EndTime.Value - run.StartTime).TotalSeconds.ToString("F1") + "s";
        }
        return "Running...";
    }

    private record ApprovalRequest(string StepId, string Reason);
    private record ExportResultInfo
    {
        public bool Success { get; init; }
        public string Type { get; init; } = "";
        public string Path { get; init; } = "";
        public string? Error { get; init; }
        public string? CliPath { get; init; }
        public string? DockerPath { get; init; }
    }
}
