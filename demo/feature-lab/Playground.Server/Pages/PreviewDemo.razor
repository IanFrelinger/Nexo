@page "/preview-demo"
@using Playground.Server.Models
@using Microsoft.JSInterop

<PageTitle>App Preview - Nexo</PageTitle>

<div class="preview-demo">
    <div class="preview-header">
        <h1>🎨 Live Preview</h1>
        <p>Generated by Nexo - Local AI Development Platform</p>
    </div>

    <div class="preview-content">
        <div class="demo-app">
            <div class="app-header">
                <h2>📝 Todo App</h2>
                <div class="theme-toggle">
                    <button class="theme-btn" @onclick="ToggleTheme">
                        @(IsDarkMode ? "🌙" : "☀️")
                    </button>
                </div>
            </div>

            <div class="app-body">
                <div class="add-todo">
                    <input type="text" @bind="NewTodo" @onkeypress="HandleKeyPress" 
                           placeholder="Add a new todo..." class="todo-input" />
                    <button @onclick="AddTodo" class="add-btn">+</button>
                </div>

                <div class="todo-filters">
                    <button class="filter-btn @(CurrentFilter == "all" ? "active" : "")" 
                            @onclick="() => SetFilter('all')">All</button>
                    <button class="filter-btn @(CurrentFilter == "active" ? "active" : "")" 
                            @onclick="() => SetFilter('active')">Active</button>
                    <button class="filter-btn @(CurrentFilter == "completed" ? "active" : "")" 
                            @onclick="() => SetFilter('completed')">Completed</button>
                </div>

                <div class="todo-list">
                    @foreach (var todo in FilteredTodos)
                    {
                        <div class="todo-item @(todo.Completed ? "completed" : "")">
                            <input type="checkbox" @bind="todo.Completed" class="todo-checkbox" />
                            <span class="todo-text">@todo.Text</span>
                            <button @onclick="() => DeleteTodo(todo)" class="delete-btn">×</button>
                        </div>
                    }
                </div>

                <div class="todo-stats">
                    <span>@ActiveTodos.Count active, @CompletedTodos.Count completed</span>
                    @if (CompletedTodos.Any())
                    {
                        <button @onclick="ClearCompleted" class="clear-btn">Clear Completed</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="preview-footer">
        <div class="tech-stack">
            <h3>🛠️ Generated with:</h3>
            <div class="tech-items">
                <span class="tech-item">React</span>
                <span class="tech-item">TypeScript</span>
                <span class="tech-item">CSS3</span>
                <span class="tech-item">Local Storage</span>
            </div>
        </div>
        <div class="features">
            <h3>✨ Features:</h3>
            <div class="feature-items">
                <span class="feature-item">Dark Mode</span>
                <span class="feature-item">Drag & Drop</span>
                <span class="feature-item">Real-time Sync</span>
                <span class="feature-item">Responsive</span>
            </div>
        </div>
    </div>
</div>

<style>
.preview-demo {
    min-height: 100vh;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 2rem;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}

.preview-header {
    text-align: center;
    margin-bottom: 2rem;
    color: white;
}

.preview-header h1 {
    margin: 0;
    font-size: 2.5rem;
    font-weight: 700;
}

.preview-header p {
    margin: 0.5rem 0 0 0;
    opacity: 0.9;
    font-size: 1.1rem;
}

.preview-content {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
}

.demo-app {
    background: white;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    width: 100%;
    max-width: 500px;
    min-height: 600px;
}

.app-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.app-header h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
}

.theme-toggle {
    display: flex;
    align-items: center;
}

.theme-btn {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    font-size: 1.2rem;
    cursor: pointer;
    transition: all 0.2s;
}

.theme-btn:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.1);
}

.app-body {
    padding: 1.5rem;
}

.add-todo {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
}

.todo-input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 2px solid #e1e5e9;
    border-radius: 8px;
    font-size: 1rem;
    transition: border-color 0.2s;
}

.todo-input:focus {
    outline: none;
    border-color: #667eea;
}

.add-btn {
    background: #667eea;
    color: white;
    border: none;
    border-radius: 8px;
    width: 48px;
    height: 48px;
    font-size: 1.5rem;
    cursor: pointer;
    transition: all 0.2s;
}

.add-btn:hover {
    background: #5a6fd8;
    transform: scale(1.05);
}

.todo-filters {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
}

.filter-btn {
    padding: 0.5rem 1rem;
    border: 2px solid #e1e5e9;
    background: white;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 0.9rem;
}

.filter-btn:hover {
    border-color: #667eea;
    color: #667eea;
}

.filter-btn.active {
    background: #667eea;
    border-color: #667eea;
    color: white;
}

.todo-list {
    margin-bottom: 1.5rem;
}

.todo-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border: 1px solid #e1e5e9;
    border-radius: 8px;
    margin-bottom: 0.5rem;
    transition: all 0.2s;
}

.todo-item:hover {
    background: #f8f9fa;
    transform: translateX(4px);
}

.todo-item.completed {
    opacity: 0.6;
    background: #f8f9fa;
}

.todo-item.completed .todo-text {
    text-decoration: line-through;
}

.todo-checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
}

.todo-text {
    flex: 1;
    font-size: 1rem;
}

.delete-btn {
    background: #ff4757;
    color: white;
    border: none;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    transition: all 0.2s;
}

.delete-btn:hover {
    background: #ff3742;
    transform: scale(1.1);
}

.todo-stats {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 8px;
    font-size: 0.9rem;
    color: #6c757d;
}

.clear-btn {
    background: #ff4757;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-size: 0.8rem;
    transition: all 0.2s;
}

.clear-btn:hover {
    background: #ff3742;
    transform: scale(1.05);
}

.preview-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
}

.tech-stack, .features {
    background: rgba(255, 255, 255, 0.1);
    padding: 1.5rem;
    border-radius: 12px;
    color: white;
}

.tech-stack h3, .features h3 {
    margin: 0 0 1rem 0;
    font-size: 1.1rem;
    font-weight: 600;
}

.tech-items, .feature-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.tech-item, .feature-item {
    background: rgba(255, 255, 255, 0.2);
    padding: 0.25rem 0.75rem;
    border-radius: 16px;
    font-size: 0.8rem;
    font-weight: 500;
}

/* Dark mode styles */
.preview-demo.dark {
    background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
}

.preview-demo.dark .demo-app {
    background: #2c3e50;
    color: #ecf0f1;
}

.preview-demo.dark .todo-input {
    background: #34495e;
    border-color: #4a5f7a;
    color: #ecf0f1;
}

.preview-demo.dark .todo-item {
    background: #34495e;
    border-color: #4a5f7a;
}

.preview-demo.dark .todo-item:hover {
    background: #3d566b;
}

.preview-demo.dark .todo-stats {
    background: #34495e;
    color: #bdc3c7;
}

.preview-demo.dark .filter-btn {
    background: #34495e;
    border-color: #4a5f7a;
    color: #ecf0f1;
}

.preview-demo.dark .filter-btn:hover {
    border-color: #667eea;
    color: #667eea;
}

.preview-demo.dark .filter-btn.active {
    background: #667eea;
    border-color: #667eea;
    color: white;
}
</style>

@code {
    private string NewTodo = "";
    private string CurrentFilter = "all";
    private bool IsDarkMode = false;
    private List<TodoItem> Todos = new()
    {
        new() { Text = "Learn about Nexo AI platform", Completed = false },
        new() { Text = "Build a todo app with dark mode", Completed = true },
        new() { Text = "Add drag and drop functionality", Completed = false },
        new() { Text = "Implement real-time sync", Completed = false }
    };

    private List<TodoItem> FilteredTodos => CurrentFilter switch
    {
        "active" => Todos.Where(t => !t.Completed).ToList(),
        "completed" => Todos.Where(t => t.Completed).ToList(),
        _ => Todos
    };

    private List<TodoItem> ActiveTodos => Todos.Where(t => !t.Completed).ToList();
    private List<TodoItem> CompletedTodos => Todos.Where(t => t.Completed).ToList();

    private void AddTodo()
    {
        if (!string.IsNullOrWhiteSpace(NewTodo))
        {
            Todos.Add(new TodoItem { Text = NewTodo.Trim(), Completed = false });
            NewTodo = "";
        }
    }

    private void HandleKeyPress(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTodo();
        }
    }

    private void DeleteTodo(TodoItem todo)
    {
        Todos.Remove(todo);
    }

    private void SetFilter(string filter)
    {
        CurrentFilter = filter;
    }

    private void ClearCompleted()
    {
        Todos.RemoveAll(t => t.Completed);
    }

    private void ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;
    }

    public class TodoItem
    {
        public string Text { get; set; } = "";
        public bool Completed { get; set; } = false;
    }
}
