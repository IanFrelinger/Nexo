<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Nexo.Native"
             xmlns:converters="clr-namespace:Nexo.Native.Converters"
             x:Class="Nexo.Native.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            
            <!-- Custom Colors -->
            <Color x:Key="PageBackgroundColor">#F5F5F5</Color>
            <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="InputBackgroundColor">#F8F9FA</Color>
            <Color x:Key="PrimaryTextColor">#212529</Color>
            <Color x:Key="SecondaryTextColor">#6C757D</Color>
            <Color x:Key="PrimaryColor">#007BFF</Color>
            <Color x:Key="SecondaryColor">#6C757D</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
