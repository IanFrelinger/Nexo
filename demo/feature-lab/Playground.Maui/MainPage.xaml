<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Playground.Maui.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Playground.Maui.ViewModels"
             x:DataType="vm:MainViewModel"
             Title="Nexo Feature Lab">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- Header -->
            <Label Text="🏗️ NEXO FEATURE LAB" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#512BD4" />
            
            <Label Text="Explore composable AI features with Nexo" 
                   FontSize="16" 
                   HorizontalOptions="Center" 
                   TextColor="Gray" />

            <!-- Feature Selection -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   Padding="15" 
                   CornerRadius="10">
                <StackLayout Spacing="10">
                    <Label Text="Select Feature" 
                           FontSize="18" 
                           FontAttributes="Bold" />
                    
                    <Picker ItemsSource="{Binding Features}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedFeature}"
                            Title="Choose a feature to run" />
                </StackLayout>
            </Frame>

            <!-- AI Mode and Provider Selection -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   Padding="15" 
                   CornerRadius="10">
                <StackLayout Spacing="15">
                    <Label Text="Configuration" 
                           FontSize="18" 
                           FontAttributes="Bold" />
                    
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="AI Mode:" VerticalOptions="Center" />
                        <Picker Grid.Row="0" Grid.Column="1" 
                                SelectedItem="{Binding SelectedMode}">
                            <Picker.Items>
                                <x:String>Off</x:String>
                                <x:String>Hybrid</x:String>
                                <x:String>Embedded</x:String>
                            </Picker.Items>
                        </Picker>
                        
                        <Label Grid.Row="1" Grid.Column="0" Text="Provider:" VerticalOptions="Center" />
                        <Picker Grid.Row="1" Grid.Column="1" 
                                SelectedItem="{Binding SelectedProvider}">
                            <Picker.Items>
                                <x:String>Local</x:String>
                                <x:String>CloudA</x:String>
                                <x:String>CloudB</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Button Grid.Row="0" Grid.Column="0" 
                        Text="Run Feature" 
                        Command="{Binding RunFeatureCommand}"
                        BackgroundColor="#512BD4" 
                        TextColor="White" 
                        CornerRadius="8" />
                
                <Button Grid.Row="0" Grid.Column="1" 
                        Text="Run Validation" 
                        Command="{Binding RunValidationCommand}"
                        BackgroundColor="#28a745" 
                        TextColor="White" 
                        CornerRadius="8" />
                
                <Button Grid.Row="1" Grid.ColumnSpan="2" 
                        Text="🏭 Try Feature Factory" 
                        Command="{Binding NavigateToFeatureFactoryCommand}"
                        BackgroundColor="#17a2b8" 
                        TextColor="White" 
                        CornerRadius="8" />
            </Grid>

            <!-- Loading Indicators -->
            <ActivityIndicator IsVisible="{Binding IsRunning}" 
                               IsRunning="{Binding IsRunning}" 
                               Color="#512BD4" />
            
            <ActivityIndicator IsVisible="{Binding IsValidating}" 
                               IsRunning="{Binding IsValidating}" 
                               Color="#28a745" />

            <!-- Run Results -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   Padding="15" 
                   CornerRadius="10">
                <StackLayout Spacing="10">
                    <Label Text="Run Results" 
                           FontSize="18" 
                           FontAttributes="Bold" />
                    
                    <Label Text="{Binding LastRunResult.FeatureName, StringFormat='Feature: {0}'}" 
                           FontSize="16" 
                           FontAttributes="Bold" />
                    
                    <Label Text="{Binding LastRunResult.Status, StringFormat='Status: {0}'}" 
                           FontSize="14" />
                    
                    <Label Text="{Binding LastRunResult.RunId, StringFormat='Run ID: {0}'}" 
                           FontSize="12" 
                           TextColor="Gray" />
                    
                    <Button Text="Clear Results" 
                            Command="{Binding ClearResultsCommand}"
                            BackgroundColor="#dc3545" 
                            TextColor="White" 
                            CornerRadius="8" />
                </StackLayout>
            </Frame>

            <!-- Validation Results -->
            <Frame BackgroundColor="White" 
                   HasShadow="True" 
                   Padding="15" 
                   CornerRadius="10">
                <StackLayout Spacing="10">
                    <Label Text="Validation Results" 
                           FontSize="18" 
                           FontAttributes="Bold" />
                    
                    <Label Text="{Binding ValidationResult.IsValid, StringFormat='Status: {0}'}" 
                           FontSize="16" 
                           FontAttributes="Bold" />
                    
                    <CollectionView ItemsSource="{Binding ValidationResult.Messages}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" 
                                       FontSize="12" 
                                       TextColor="Green" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                    <Button Text="Clear Results" 
                            Command="{Binding ClearResultsCommand}"
                            BackgroundColor="#dc3545" 
                            TextColor="White" 
                            CornerRadius="8" />
                </StackLayout>
            </Frame>

        </StackLayout>
    </ScrollView>

</ContentPage>